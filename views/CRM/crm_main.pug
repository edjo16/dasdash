  include ../crm/crm_case_modal

  script.
    // Auto-set assigned-to-me filter when key=Pending (replaces old /crm_main_asigned route)
    (function() {
      var params = new URLSearchParams(window.location.search);
      if (params.get('key') === 'Pending') {
        var asignedInput = document.getElementById('crm_filtro_asgined');
        if (asignedInput) asignedInput.value = '1';
      }
    })();

    window._benDepartments = !{JSON.stringify(typeof departments !== 'undefined' ? departments : [])};
    window._benCompanies = !{JSON.stringify(typeof companies !== 'undefined' ? companies : [])};
    localStorage.setItem('backpage', 'index');
    let currentPage = 1;
    let totalCount = 0;
    // Bridge: crm_case_modal calls _beneficiaryListRefresh after saving a case type
    window._beneficiaryListRefresh = function(newTypeId){
      if(typeof window.refreshCtSelect_intern_subject === 'function')
        window.refreshCtSelect_intern_subject(newTypeId);
    };

  //- ═══════════════════════════════════════════════════════════════
  //- 🔧 Tech Support Auto-Assignment Feature
  //- ═══════════════════════════════════════════════════════════════
  script.
    // Global state for Tech Support locking
    var _techSupportLocked = false;
    var _lockedUserId = null;
    var _techSupportUsers = [];

    // Get user by name (abarahona)
    function findTechSupportUser(label) {
      var allUsers = !{JSON.stringify(typeof grupousuarios_active !== 'undefined' ? grupousuarios_active : [])};
      
      var techUser = allUsers.find(function(u) {
        return (u.UserID || '').toLowerCase().includes('abarahona') ||
               (u.Name || '').toLowerCase().includes('abarahona');
      });
      
      return techUser || null;
    }

    //  Lock user chip (make it non-removable with visual indicator)
    function lockAssignedUserChip(userId) {
      var display = document.querySelector('.floating-users-display[data-name="crm_asignados"]');
      if (!display) return;
      
      var chips = display.querySelectorAll('.chip[data-value="' + userId + '"]');
      chips.forEach(function(chip) {
        chip.style.borderColor = '#FF6B6B';
        chip.style.borderWidth = '2px';
        var removeBtn = chip.querySelector('.remove-chip');
        if (removeBtn) {
          removeBtn.style.display = 'none';
        }
        chip.title = 'Tech Support assigned user (cannot be removed)';
        chip.style.cursor = 'not-allowed';
      });
    }

    // Unlock user chip (restore normal behavior)
    function unlockAssignedUserChip(userId) {
      var display = document.querySelector('.floating-users-display[data-name="crm_asignados"]');
      if (!display) return;
      
      var chips = display.querySelectorAll('.chip[data-value="' + userId + '"]');
      chips.forEach(function(chip) {
        chip.style.borderColor = '';
        chip.style.borderWidth = '';
        var removeBtn = chip.querySelector('.remove-chip');
        if (removeBtn) {
          removeBtn.style.display = '';
        }
        chip.title = '';
        chip.style.cursor = '';
      });
    }

    // Sync assigned users from DOM to hidden input
    function syncAssignedFromDom() {
      var display = document.querySelector('.floating-users-display[data-name="crm_asignados"]');
      if (!display) return;
      
      var hiddenInputs = display.querySelectorAll('input[type="hidden"]');
      var selected = Array.from(hiddenInputs).map(function(i) { return i.value; });
      
      var globalHidden = document.getElementById('newcase_asignados');
      if (globalHidden) {
        globalHidden.value = selected.join(';');
      }
    }

    // Handle Case Type change
    function onCaseTypeChange(label) {
      var isTechSupport = label.trim().toLowerCase() === 'tech support';

      if (isTechSupport && !_techSupportLocked) {
        var techUser = findTechSupportUser(label);
        if (!techUser) {
          console.warn('Tech Support user (abarahona) not found');
          return;
        }

        _lockedUserId = techUser.UserID;

        // Add user if not already selected
        if (typeof selectFloatingMultiselectOption === 'function') {
          selectFloatingMultiselectOption('crm_asignados', _lockedUserId);
        }

        syncAssignedFromDom();

        // ⏱ Wait for chip render
        setTimeout(function() {
          lockAssignedUserChip(_lockedUserId);
        }, 50);

        _techSupportLocked = true;
      }
      else if (!isTechSupport && _techSupportLocked) {
        if (_lockedUserId && typeof removeFloatingMultiselectChip === 'function') {
          removeFloatingMultiselectChip('crm_asignados', _lockedUserId);
        }

        syncAssignedFromDom();
        unlockAssignedUserChip(_lockedUserId);

        _lockedUserId = null;
        _techSupportLocked = false;
      }
    }

    // Setup observer for Case Type changes
    document.addEventListener('DOMContentLoaded', function() {
      var selectedSpan = document.getElementById('intern_subject_selected');
      if (!selectedSpan) {
        console.warn('intern_subject_selected element not found');
        return;
      }

      var prevLabel = '';
      var observer = new MutationObserver(function() {
        var label = (selectedSpan.textContent || '').trim();
        if (label !== prevLabel) {
          prevLabel = label;
          onCaseTypeChange(label);
        }
      });

      observer.observe(selectedSpan, { childList: true, characterData: true, subtree: true });
    });

    // ═══════════════════════════════════════════════════════════════
    // Assignee filter — sync hidden input + trigger reload on change
    // ═══════════════════════════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', function() {
      var filterDisplay = document.querySelector('.floating-users-filter-display[data-name="filter_asignados"]');
      if (!filterDisplay) return;

      var _assigneeFilterTimeout = null;

      var assigneeObs = new MutationObserver(function() {
        if (filterDisplay._restoringFilter) return;
        clearTimeout(_assigneeFilterTimeout);
        _assigneeFilterTimeout = setTimeout(function() {
          var hiddenInputs = filterDisplay.querySelectorAll('input[type="hidden"]');
          var selected = Array.from(hiddenInputs).map(function(i) { return i.value; });
          var globalHidden = document.getElementById('filter_asignados_value');
          if (globalHidden) globalHidden.value = selected.join(';');
          currentPage = 1;
          load_main();
        }, 50);
      });

      assigneeObs.observe(filterDisplay, { childList: true });
    });

  style.


