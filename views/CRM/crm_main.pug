            +fb-download-btn
            +fb-view-toggle({id: 'crmViewMode', tableId: 'MainTable', ariaLabel: 'Select CRM data view'})
            +fb-page-size({id: 'SelectBoxPages', sizes: [15, 50, 100, 250], onchange: 'load_main()'})
