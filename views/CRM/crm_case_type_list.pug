extends ../layout
include ../ui/filter-bar
include ../mixins/floating-input
include ../mixins/floating-textarea
include ../mixins/data-table
include ../mixins/floating-select
include ../mixins/breadcrumb

block layout-content
  div#layoutSidenav_content
    main
      div.container-fluid.px-4
        input#username(type="hidden" value=userProfile.UsuarioID)
        input#compania_val(type="hidden" value=compania)

        +app-breadcrumb({
          homeHref: '/',
          items: [{ label: title, active: true }]
        })

        - var depItems = (typeof departments !== 'undefined' ? departments : []).map(function(d){ return {value:d.id,label:d.nombre}; })
        - var estadoItems = [{value:'1',label:'Active'},{value:'0',label:'Inactive'}]

        +fb-bar
          button#btnNewCaseType.fb-btn(
            type="button"
            onclick="openNewCaseTypeModal()"
          )
            i.fas.fa-plus
            span New case type
          +fb-select({id: 'depFilter', icon: 'fa-building', items: depItems, placeholder: 'All departments', placeholderDisabled: false, onchange: 'fetchPage(1)', minWidth: '150px'})
          +fb-select({id: 'estadoFilter', icon: 'fa-circle', items: estadoItems, placeholder: 'All statuses', placeholderDisabled: false, onchange: 'fetchPage(1)', minWidth: '120px', iconStyle: 'font-size:.45rem;'})
          +fb-reset-btn({onclick: 'resetCaseTypeFilters()'})
          +fb-actions
            +fb-search({id: 'searchInput', placeholder: 'Search by label', onkeyup: 'handleSearchInput()'})
            +fb-view-toggle({id: 'caseTypeViewMode', tableId: 'MainTable', ariaLabel: 'Select case type data view'})
            +fb-page-size({id: 'limitSelect', sizes: [15, 25, 50], defaultSize: 15, onchange: 'fetchPage(1)'})
            +fb-pagination({onPrev: 'handlePrevPage()', onNext: 'handleNextPage()'})

        +data-table('MainTable', '_noCount', { internalViewToggle: false })
          thead
            tr#header
              th(style="width:4%") #
              th Company
              th Dep
              th Case Type
              th Access
              th Status
          tbody#beneficiaryTbody.bg-white
            tr
              td.text-center.py-4(colspan="6")
                span.spinner-border.spinner-border-sm.me-2
                | Loading…
        span#totalCount

  include ./crm_case_modal

  script.
    window._benDepartments = !{JSON.stringify(departments || [])};
    window._benCompanies   = !{JSON.stringify(companies   || [])};
    window._benDefaultCompania = !{JSON.stringify(compania || '')};
    window._benDefaultDep      = !{JSON.stringify(userProfile.Dep || '')};
    (function(){
      let state = { page:1, limit:15, total:0 };

      const get  = id => document.getElementById(id);
      const user = () => get('username')?.value || '';
      const q    = () => (get('searchInput')?.value || '').trim();
      const depFilter    = () => get('depFilter')?.value    || '';
      const estadoFilter = () => get('estadoFilter')?.value || '';
      const esc  = v  => (v == null ? '' : String(v)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

      // ── Table / pagination logic ────────────────────────────────────────
      async function fetchPage(page){
        state.page = page;
        state.limit = parseInt(get('limitSelect')?.value || '15');
        const tbody = get('beneficiaryTbody');
          tbody.innerHTML = '<tr><td class="text-center py-4" colspan="6"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</td></tr>';
        try {
          const res = await fetch('/cases_type-list', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user: user(), q: q(), page: state.page, limit: state.limit,
              dep_filter: depFilter() || null, estado: estadoFilter() !== '' ? estadoFilter() : null })
          });
          if(!res.ok) throw new Error('Status ' + res.status);
          const json = await res.json();
          state.total = json.total || 0;
          renderTable(json.data || []);
          renderPager();
        } catch(err) {
          console.error(err);
          tbody.innerHTML = '<tr><td class="text-center text-danger py-4" colspan="6">Error loading data.</td></tr>';
        }
      }

      function renderTable(rows){
        const tbody  = get('beneficiaryTbody');
        const counter = get('totalCount');
        if(!rows.length){
          tbody.innerHTML = '<tr><td class="text-center text-muted py-4" colspan="6">No types found.</td></tr>';
          if(counter) counter.textContent = '';
          return;
        }
        const start = (state.page - 1) * state.limit + 1;
        const end   = Math.min(state.page * state.limit, state.total);
        if(counter) counter.textContent = 'Showing ' + start + '–' + end + ' of ' + state.total;

        tbody.innerHTML = rows.map((r, i) => {
          const canEdit = r.edit === true;
          const badge   = canEdit
            ? '<span class="badge bg-success">Edit</span>'
            : '<span class="badge bg-secondary">View</span>';
          return '<tr onclick="openCaseTypeModal(\'' + r.type_id + '\')">'
            + '<td class="text-muted">' + (start + i) + '</td>'
            + '<td>' + esc(r.compania_nombre) + '</td>'
            + '<td>' + esc(r.departamento) + '</td>'
            + '<td>' + esc(r.label) + '</td>'
            + '<td>' + badge + '</td>'+
            '<td>' + (r.estado == 1 ? '<span class="badge bg-success">Active</span>' : r.estado == 0 ? '<span class="badge bg-danger">Inactive</span>' : '') + '</td>' +
            '</tr>';
        }).join('');
      }

      function renderPager(){
        const totalPages = Math.ceil(state.total / state.limit) || 1;
        const fbPaginationBtns = document.querySelectorAll('.fb-pagination .fb-page-btn');
        if(fbPaginationBtns.length >= 2){
          fbPaginationBtns[0].disabled = state.page <= 1;
          fbPaginationBtns[1].disabled = state.page >= totalPages;
        }
      }

      // Handle search with debounce on Enter key
      window.handleSearchInput = function() {
        fetchPage(1);
      };

      // Handle prev/next buttons
      window.handlePrevPage = function() {
        if(state.page > 1) fetchPage(state.page - 1);
      };

      window.handleNextPage = function() {
        const totalPages = Math.ceil(state.total / state.limit) || 1;
        if(state.page < totalPages) fetchPage(state.page + 1);
      };

      // Reset filters to defaults
      window.resetCaseTypeFilters = function() {
        if(get('searchInput')) get('searchInput').value = '';
        if(get('depFilter')) get('depFilter').value = '';
        if(get('estadoFilter')) get('estadoFilter').value = '';
        if(get('limitSelect')) get('limitSelect').value = '15';
        state.page = 1;
        state.limit = 15;
        fetchPage(1);
      };

      window._beneficiaryListRefresh = () => fetchPage(state.page);

      document.addEventListener('DOMContentLoaded', function(){
        fetchPage(1);
        get('searchInput')?.addEventListener('keydown', e => { if(e.key === 'Enter') handleSearchInput(); });
        get('searchInput')?.addEventListener('input',   () => { if(!get('searchInput').value) handleSearchInput(); });
        get('depFilter')?.addEventListener('change',    () => fetchPage(1));
        get('estadoFilter')?.addEventListener('change', () => fetchPage(1));
        get('limitSelect')?.addEventListener('change',  () => fetchPage(1));
      });
    })();

  style.
    .shadow-table {
      overflow-y: auto;
      overflow-x: auto;
      max-height: calc(100vh - 340px);
    }
    #MainTable { table-layout: fixed; width: 100%; }
    #MainTable thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background: #ffffff;
    }
    #MainTable tbody tr td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .shadow-table::-webkit-scrollbar { width: 5px; }
    .shadow-table::-webkit-scrollbar-track { background: transparent; }
    .shadow-table::-webkit-scrollbar-thumb { background: #c0cdd4; border-radius: 10px; }
    .shadow-table::-webkit-scrollbar-thumb:hover { background: #00586f; }
    span#totalCount { display:block; font-size:.8rem; color:#6b7280; margin-top:.35rem; padding-left:2px; }

