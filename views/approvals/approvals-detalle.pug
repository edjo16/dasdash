  script.
    function openCreateCrmModal() {
      var modal = document.getElementById('crm_from_approval_modal');
      if (modal) modal.classList.add('open');
    }
    function closeCreateCrmModal() {
      var modal = document.getElementById('crm_from_approval_modal');
      if (modal) modal.classList.remove('open');
    }
    async function submitCreateCrmFromApproval() {
      var display = document.querySelector('.floating-users-display[data-name="cr_asignados"]');
      var hiddenInputs = display ? display.querySelectorAll('input[type="hidden"]') : [];
      var asignados = Array.from(hiddenInputs).map(function(i) { return i.value; }).join(';');
      var cprioridad = document.getElementById('cr_prioridad') ? document.getElementById('cr_prioridad').value : '0';
      var UserID = new URL(window.location.href).searchParams.get('p') || '';
      var approvalId = document.getElementById('ID') ? document.getElementById('ID').value : '';
      var btn = document.getElementById('submitCrmFromApproval');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Creating...'; }
      try {
        var response = await fetch('/create-crm-from-change-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            UserID: UserID,
            approval_id: approvalId,
            form_id: approvalId,
            asignados: asignados,
            cprioridad: cprioridad
          })
        });
        var data = await response.json();
        if (data.result === 1) {
          closeCreateCrmModal();
          if (typeof loadCrmRelations === 'function') loadCrmRelations();
        } else {
          alert('Error creating CRM: ' + (data.error || 'Unknown error'));
        }
      } catch (e) {
        alert('Error: ' + e.message);
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-save me-1"></i> Create CRM'; }
      }
    }

