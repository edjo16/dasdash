      function showMoreOptions() {
        const showMoreBtn = document.getElementById('showMoreBtn');
        if (showMoreBtn) {
          showMoreBtn.classList.toggle('fa-chevron-down');
          showMoreBtn.classList.toggle('fa-chevron-up');
        }
        const tableBody = document.getElementById('optionsTable');
        if (!tableBody) return;
        const hiddenTds = tableBody.querySelectorAll('.hidden');
        hiddenTds.forEach(td => {
          td.classList.remove('hidden');
        });
        if (hiddenTds.length === 0) {
          tableBody.querySelectorAll('tr').forEach(tr => {
            if (tr.rowIndex >= 2) {
              tr.classList.add('hidden');
            }
          });
        }
      }
      
      function goApprovals() {
        var url_string = window.location.href;
        var url = new URL(url_string);
        var params = new URLSearchParams(url.search);
        let key = params.get('key');
        let p = params.get('p');
        let iddevteam = params.get('iddevteam');
        
        let newUrl = `/approvals-total`;
        newUrl = newUrl.replace(/&$/, '');
        window.location.href = newUrl;
     }
     function cancelApproval() {
        var form = document.getElementById('cancelApprovalForm');
        var xhr = new XMLHttpRequest();
        xhr.open('POST', form.action, true);
        xhr.onload = function () {
          if (xhr.status === 200) {
            location.reload();
          } else {
            alert('Error cancelling approval');
          }
        };
        var formData = new FormData(form);
        xhr.send(formData);
      }
      
      // Entry point bound on Cancel buttons. Shows modal first.
      function cancelApprovalForm(evt) {
        if (evt && evt.preventDefault) evt.preventDefault();
        // Prefer Bootstrap modal if available
        const modalEl = document.getElementById('cancelConfirmModal');
        if (modalEl && window.bootstrap && window.bootstrap.Modal) {
          try {
            let instance = window.bootstrap.Modal.getInstance(modalEl);
            if (!instance) instance = new window.bootstrap.Modal(modalEl);
            instance.show();
            // Store instance globally so confirm can hide it
            window._cancelModalInstance = instance;
            return;
          } catch (e) { /* fallthrough to native confirm */ }
        }
        // Fallback to native confirm
        if (window.confirm('You really want to cancel this approval?')) {
          cancelApproval();
        }
      }
      // Cancel confirmation handlers
      function confirmCancelProceed() {
        try {
          const modalEl = document.getElementById('cancelConfirmModal');
          if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            const instance = window.bootstrap.Modal.getInstance(modalEl) || new window.bootstrap.Modal(modalEl);
            instance.hide();
          }
        } catch (e) { /* ignore */ }
        cancelApproval();
      }
