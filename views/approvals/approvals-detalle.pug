  script.
    function openPtoDetailModal(formId) {
      var modal = document.getElementById('ptoDetailModal');
      if (modal) {
        modal.classList.add('open');
        loadPtoDetail(formId);
      }
    }
    function closePtoDetailModal() {
      var modal = document.getElementById('ptoDetailModal');
      if (modal) modal.classList.remove('open');
    }
    async function loadPtoDetail(formId) {
      var content = document.getElementById('ptoDetailContent');
      content.innerHTML = '<div style="text-align:center;padding:20px;"><i class="fas fa-spinner fa-spin"></i></div>';
      try {
        var res = await fetch('/form_hr_personal_time_off/' + formId + '/data');
        var data = await res.json();
        if (data.result === 1) {
          var form = data.form;
          var typeLabels = {
            vacation: 'Vacation',
            medical_cert: 'Medical Certificate',
            no_medical_cert: 'Absence without Medical Certificate',
            partial_permit: 'Partial Permit',
            non_remunerated: 'Non-remunerated Time',
            license: 'License'
          };
          var rows = '';
          rows += '<tr><th>Request Type</th><td>' + (typeLabels[form.request_type] || form.request_type) + '</td></tr>';
          if (form.request_type === 'partial_permit' && form.start_permit_hour) {
            rows += '<tr><th>Hours</th><td>' + form.start_permit_hour + ' - ' + form.end_permit_hour + '</td></tr>';
          }
          var sd = form.start_date ? form.start_date.split('T')[0].split('-').reverse().join('/') : '-';
          var ed = form.end_date ? form.end_date.split('T')[0].split('-').reverse().join('/') : '-';
          rows += '<tr><th>Start Date</th><td>' + sd + '</td></tr>';
          rows += '<tr><th>End Date</th><td>' + ed + '</td></tr>';
          rows += '<tr><th>Days</th><td>' + form.days + ' Days' || '-' + '</td></tr>';
          rows += '<tr><th>Notes</th><td>' + (form.notes || '-') + '</td></tr>';
          content.innerHTML = '<table class="pto-detail-modal-table">' + rows + '</table>';
        } else {
          content.innerHTML = '<p style="color:red;">Could not load data.</p>';
        }
      } catch (e) {
        content.innerHTML = '<p style="color:red;">Error: ' + e.message + '</p>';
      }
    }
