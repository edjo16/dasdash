extends ../layout

include ../mixins/floating-users
include ../mixins/floating-select
include ../mixins/floating-textarea
include ../mixins/floating-file
include ../ui/button-submit
include ../mixins/categorization-items-modal
include ../mixins/breadcrumb
include ../mixins/ai-chat-modal
include ../mixins/add-reference
block layout-content
  div#layoutSidenav_content
    main
      div.container-fluid.px-4
        input#username(type="hidden" value=userProfile.UsuarioID)
        input#compania_val(type="hidden" value=ccompania)
        input#approval_id_ai(type="hidden" value=detalle.RowID)
        div.row(style="display:flex; margin-top: 0;")
            div.col-md-9(style="flex: 1")
                +app-breadcrumb({
                  homeHref: '/',
                  items: [
                    { label: 'Approvals', href: '/approvals-total' },
                    { label: `Approval # ${detalle.RowID}`, active: true }]
                })
                button#openApprovalAiModal.btn.btn-sm(type='button' title='AI Assistant' style='margin-left:8px;background-color:#ffffff;border:1px solid #dee2e6;color:#495057;display:inline-flex;align-items:center;gap:6px;')
                  img(src='/icono-ia.png' width='18' height='18' style='object-fit:contain;' onerror="this.style.display='none';this.nextSibling.style.display='inline-block'")
                  span(style='font-size:0.78rem;') AI Assistant  
                if devteam === true
                  button(type="button" class="btn btn-sm approval-ai-btn" data-bs-toggle="modal" data-bs-target="#exampleModal")
                    i.detail-icon.fas.fa-info
                  div.modal.fade(tabindex="-1" id="exampleModal" aria-labelledby="exampleModalLabel" aria-hidden="true")
                    div.modal-dialog
                      div.modal-content
                        div.modal-header
                          h5.modal-title(id="exampleModalLabel") Info Log
                          button(type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close")
                        div.modal-body(style="font-size: 1.1rem;")
                          p Flow: #{infoLog.cflow}
                          p form_id: #{infoLog.form_id}
                          p mform: #{infoLog.mform}
                          p UserID: #{infoLog.UserID}
                          p department: #{infoLog.cdepartamento}
                          p id_original: #{infoLog.id_original}
                          p id_nuevo: #{infoLog.id_nuevo}
            div.col-md-3(style="flex: 0 0 300px; padding-top: 12px;")
              span.actualStatus Approval status:  
              if detalle.cierre_fecha || detalle.estado === 'Rejected' || detalle.estado === 'Cancelled'
                span.status(style=`background-color:gray; margin-right: 2px;`) Closed
              else
                span.status(style=`background-color:#ffc107; margin-right: 2px;`) Open
              span.status(style=`background-color: ${
                detalle.estado === 'Verify' || detalle.estado === 'Verified' ? '#00ACA0' :
                detalle.estado === 'Signature' || detalle.estado === 'Signed' ? '#7FC0F5' :
                detalle.estado === 'Approve' || detalle.estado === 'Approved' ? '#85C8D5' :
                detalle.estado === 'Execute' || detalle.estado === 'Executed' ? '#00586f' :
                detalle.estado === 'canceled' ? 'gray' :
                detalle.estado === 'expired' || detalle.estado === 'Rejected' ? 'red' :
                detalle.estado === 'Apply' ? '#3660AC' : 'gray'
              }`) #{detalle.estado}
              div.col-md-11(style="display: flex;align-items: flex-end;justify-content: space-between;padding: 5px 10px ") 
                  if(detalle.accion)
                    span Action:
                      if(detalle.ctipo_flujo==2 || detalle.ctipo_flujo==3)
                        //- Si el flujo es de una orden de pago y ya esta asignado
                        if(detalle.accion=='asignado')
                          if(detalle.estado1=='Rejected' || detalle.estado1=='Cancelled')
                            a.actions(href="#" onclick='ApprovalCreate("'+detalle.RowID+'")')
                              i.fas.fa-plus
                          if(detalle.estado1==null)
                            a.actions(href="#" onclick='ApprovalCreate("'+detalle.RowID+'")')
                              i.fas.fa-plus
                        else
                          if(detalle.estado=='Execute')
                            - var list=['Cancelled', 'Rejected']
                            if(!fatherLog || list.includes(fatherLog.estado))
                              span#asignacionusuarios.actions(href="#").clic
                                i.fas.fa-users
                            if(fatherLog && fatherLog.estado=='Executed')
                              a.actions(href="#" onclick='ActionApproval("'+detalle.accion+'","'+detalle.accion+'")')
                                i.fas.fa-check
                            a.actions(href="#" onclick='openRejectConfirm("'+detalle.accion+'")')
                              i.fas.fa-ban
                          if(detalle.estado!='Executed')
                            if(detalle.estado!='Execute')
                              a.actions(href="#" onclick='ActionApproval("'+detalle.accion+'","'+detalle.accion+'")')
                                i.fas.fa-check
                              a.actions(href="#" onclick='openRejectConfirm("'+detalle.accion+'")')
                                i.fas.fa-ban
                      else
                        a.actions(href="#" onclick='ActionApproval("'+detalle.accion+'","'+detalle.accion+'")')
                          i.fas.fa-check
                        a.actions(href="#" onclick='openRejectConfirm("'+detalle.accion+'")')
                          i.fas.fa-ban
                      //- if(detalle.mform === 4 && !hasCrmRelation && detalle.estado !== 'Cancelled' && detalle.estado !== 'Rejected')
                      //-   a.actions(href="#" onclick='openCreateCrmModal()' title='Create CRM from Change Request')
                      //-     i.fas.fa-user-plus
                  else
                      if(detalle.estado=='Executed')
                        if(detalle.proceso=='RRHH Ausencias y Vacaciones' && userMenu.Modules.includes("RRHH"))
                          a.actions(href="#" onclick="ActionApproval('Execute','Execute')")
                            i.fas.fa-check
                          a.actions(href="#" onclick="openRejectConfirm('Rejected')")
                              i.fas.fa-ban
                  if (userProfile.permisionToCancel === true && detalle.estado !== 'Cancelled' && detalle.estado !== 'Rejected' && !detalle.cierre_fecha)
                    if(isOriginal === true)
                      form#cancelApprovalForm(method="POST" action="/cancel_approval" style="display:none;")
                        input(type="hidden" name="id" value=detalle.RowID)
                      button(type="button" class="btn btn-secondary" style="margin-left: 5px; margin-right: 5px;" onclick="cancelApprovalForm(event)")
                        i.detail-icon.fas.fa-ban(style="fontzise: .1rem;")
                        span(style="padding-left: 0.2rem;") Cancel
                    if(isOriginal === false && fatherLog)
                      if (fatherLog.estado == 'Cancelled'|| fatherLog.estado == 'Rejected')
                        form#cancelApprovalForm(method="POST" action="/cancel_approval" style="display:none;")
                          input(type="hidden" name="id" value=detalle.RowID)
                        button(type="button" class="btn btn-secondary" style="margin-left: 5px; margin-right: 5px;" onclick="cancelApprovalForm(event)")
                          i.detail-icon.fas.fa-ban(style="fontzise: .1rem;")
                          span(style="padding-left: 0.2rem;") Cancel
                    if(isOriginal === false && (fatherLog === null))
                        form#cancelApprovalForm(method="POST" action="/cancel_approval" style="display:none;")
                          input(type="hidden" name="id" value=detalle.RowID)
                        button(type="button" class="btn btn-secondary" style="margin-left: 5px; margin-right: 5px;" onclick="cancelApprovalForm(event)")
                          i.detail-icon.fas.fa-ban(style="fontzise: .1rem;")
                          span(style="padding-left: 0.2rem;") Cancel
        if (fatherLog && (validateSeeSupport || validateSupportViewApproval))
            div.containerDetails-top.col-md-12(style="margin-bottom: 10px;")
              .d-flex.align-items-center
                h6.m-0
                  if(isOriginal === true)
                    | Initial Approval # #{fatherLog.id}
                  else
                    | Support Approval # #{fatherLog.id}
                if(validateSeeSupport)
                  i.detail.fas.fa-eye(id="seeApproval" onclick="approval_detalle_view("+fatherLog.id+")" style="cursor:pointer; margin-left: 10px;")
                i.detail.fas.fa-chevron-down(id="toggleFatherApproval" onclick="toggleFatherApproval()" style="cursor:pointer; margin-left: 10px;")
              div.row#ShowFather.hidden(style="margin-top: 1rem;")
                p.titleDetail Description:
                div.rich-detail-content!= fatherLog.detalle_proceso
                if(fatherLog.solicitante!="N/A")
                  div.col-md-3
                    h6#requestor.title_persons Requestor
                    img(src=`pic/${fatherIntegrants.solicitante}.png` class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                    span=fatherLog.solicitante
                    div.col-md-12
                      span.titleDetail Date: 
                      span=fatherLog.solicitante_fecha

                if(fatherLog.verificador!="N/A")
                  div.col-md-1(style="text-align: center")
                    i.detail.fas.fa-arrow-right
                  div.col-md-3
                    h6#verifier.title_persons Verifier
                      if(fatherLog.estado == "Verify")
                        i#blinking.fas.fa-hourglass(style="color:#ffffff; margin-left: 5px;")
                    img(src=`pic/${fatherIntegrants.verificador}.png` class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                    span=fatherLog.verificador
                    div.col-md-12
                      span.titleDetail Dates: 
                      span(style="margin-rigth: 10px")=fatherLog.v_fecha
                      p.titleDetail Verifier Comments:
                      if(!fatherLog.verificador_comentarios)
                        i None
                      else
                        p=fatherLog.verificador_comentarios
                if(fatherLog.aprobador!="N/A")
                  div.col-md-1(style="text-align: center")
                    i.detail.fas.fa-arrow-right
                  div.col-md-3
                    h6#approver.title_persons Approver
                      if(fatherLog.estado == "Approve")
                        i#blinking.fas.fa-hourglass(style="color:#ffffff; margin-left: 5px;")
                    img(src=`pic/${fatherIntegrants.aprobador}.png`  class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                    span=fatherLog.aprobador
                    div.col-md-12
                      span.titleDetail Date: 
                      span=fatherLog.a_fecha
                      p.titleDetail Approver Comments:
                      if(!fatherLog.aprobador_comentarios || fatherLog.aprobador_comentarios == ' ')
                        i None
                      else
                        p=fatherLog.aprobador_comentarios
                if(fatherLog.firmante!="N/A")
                  div.col-md-1(style="text-align: center")
                    i.detail.fas.fa-arrow-right
                  div.col-md-3
                    h6#signer.title_persons Signer
                      if(fatherLog.estado == "Signature")
                        i#blinking.fas.fa-hourglass(style="color:#ffffff; margin-left: 5px;")
                    img(src=`pic/${fatherIntegrants.firmante}.png` class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                    span=fatherLog.firmante
                    div.col-md-12
                      span.titleDetail Date: 
                      span=fatherLog.f_fecha
                      p.titleDetail Signer Comments:
                      if(!fatherLog.firmante_comentarios || fatherLog.aprobador_comentarios == ' ')
                        i None
                      else
                        p=fatherLog.firmante_comentarios
                if(fatherLog.operador!="N/A")
                  div.col-md-1(style="text-align: center")
                    i.detail.fas.fa-arrow-right
                  div.col-md-3
                    h6#operator.title_persons Operator:
                      if(fatherLog.estado == "Apply")
                        i#blinking.fas.fa-hourglass(style="color:#ffffff; margin-left: 5px;")
                    img(src=`pic/${fatherIntegrants.operador}.png` class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                    span=fatherLog.operador
                    div.col-md-12
                      span.titleDetail Date:
                      span=fatherLog.o_fecha
                      p.titleDetail Operator Comments:
                      if(!fatherLog.operador_comentarios || fatherLog.aprobador_comentarios == ' ')
                        i None
                      else
                        p=fatherLog.operador_comentarios
                    hr
                if(fatherLog.ejecutor!="N/A")
                  div.col-md-1(style="text-align: center")
                    i.detail.fas.fa-arrow-right
                  div.col-md-3
                    h6#executor.title_persons Executioner
                      if(fatherLog.estado == "Execute")
                        i#blinking.fas.fa-hourglass(style="color:#ffffff; margin-left: 5px;")
                    img(src=`pic/${fatherIntegrants.ejecutor}.png` alt="PDF Icon" class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                    span=fatherLog.ejecutor
                    div.col-md-12
                      span.titleDetail Date: 
                      span=fatherLog.e_fecha
                      p.titleDetail Executioner Comments:
                      if(!fatherLog.ejecutor_comentarios || fatherLog.ejecutor_comentarios == ' ')
                        i None
                      else
                        p=fatherLog.ejecutor_comentarios
                if(fatherLog.asignado != 'N/A')
                    div.col-md-1(style="text-align: center")
                      i.detail.fas.fa-arrow-right
                    div.col-md-3
                      h6#asignado.title_persons Asignated to
                      img(src=`pic/${fatherIntegrants.asignado}.png` alt="PDF Icon" class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                      span=fatherLog.asignado
                      div.col-md-12
                        span.titleDetail Date:
                        span=fatherLog.asignado_fecha
              //- Approval Action Form
        div#ApprovalAction.ApprovalActionNone
          form#FormApprovalsDetalle(method="post" action="" enctype="multipart/form-data")
            .modal-background(style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.21); display: flex; justify-content: center; align-items: center;")
            div.row(style="max-width: 300px; z-index: 999999; position: fixed; top: 0; right: 0; height: 100%; padding: 15px 20px 10px; background-color: #ffff; border-radius: 0.25rem; overflow-y: auto; display: flex; flex-direction: column;")
              div.row(style="padding-bottom: 0px;")
                div.Not
                  input#RowID(name='RowID' value=detalle.RowID)
                  input#nombre(name='nombre' value=userProfile.UserName)
                  input#departamento(name='departamento' value=detalle.departamento)
                  input#estado(name='estado' value=detalle.estado)
                  input#estado1(name='estado1' value=detalle.estado1)
                div.row(style="padding-bottom: 0px;")
                  div.col-md-12(style="position: relative;")
                    a.actions(href="#" onclick='ActionApproval("'+detalle.accion+'","'+detalle.accion+'")')
                      img.crm_icons(style="width: 20px; height: 20px; position: absolute; top: 0; right: 0; " src="/img/xmark-solid.svg" title="Close")
                    +floating-select('Result', 'AccionFinal', [{label:`${detalle.accion}`, value: `${detalle.accion}`}, {label:'Rejected', value:'Rejected'}], true, 'Select action', '', '', {defaultValue: `${detalle.accion}`})
                  div.col-md-12
                    +floating-textarea('Comments', 'comentario', true, '', '', '', {maxlength: '400'}, 4)
                  if(detalle.estado1 == 'Executed')
                    +floating-file(detalle.proceso && detalle.proceso.includes('Posted Remittance') ? 'Journal Entry' : 'Proof of Payment', 'PaymentSupportfiles', true, true, false)
                  div.col-md-12
                    +submit-button('ApprovalActionbtn', 'Submit')
                //- User Assignment Form
        div#ApprovalAsignacion.Not
          form#FormAsignacion(method="POST" action="" enctype="multipart/form-data")
            .modal-background(style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); display: flex; justify-content: center; align-items: center;")
            div.row(style=" z-index: 100; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 15px 25px 10px; background-color: #ffff; border-radius: 0.25rem;")
                div.Not
                  div
                    input#nombre(name='nombre' value=userProfile.UserName)
                    input#ID(name='ID' value=detalle.RowID)
                    input#RowID(name='RowID' value=detalle.RowID)
                    input#cdepatamento(name='cdepatamento' value=userProfile.cdepatamento)
                    input#departamentoDestino(name='departamentoDestino' value=detalle.departamentoDestino)
                    input#estado(name='estado' value=detalle.estado)
                div.row
                  div.col-md-12(style="position: relative;")
                    a(href="#" onclick="hideApprovalAction()")
                      img.crm_icons(style="width: 20px; height: 20px; position: absolute; top: 0; right: 0;" src="/img/xmark-solid.svg" title="Close")
                  - const uasignarOptions = (userProfile.departamento_user == 3 || userProfile.departamento_user == 1) ? asignados.map(a => ({value: a.Name, label: a.Name})) : [{value: userProfile.UserName, label: userProfile.UserName}]
                  div.col-md-12
                    +floating-select('Assign collaborator', 'uasignar', uasignarOptions, true)
                  div.col-md-12
                    +floating-textarea('Comments', 'comentario_asignar', true, 'Write a comment here...', '', '', {maxlength: '400'}, 4)
                div.row
                  div.col-md-3
                    +submit-button('Asignarbtn', 'Submit')

        //- Reject confirmation modal
        div.modal.fade#rejectConfirmModal(tabindex='-1' aria-labelledby='rejectConfirmLabel' aria-hidden='true')
          div.modal-dialog
            div.modal-content
              div.modal-header
                h5#rejectConfirmLabel.modal-title Confirm Rejection
                button(type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close')
              div.modal-body
                | You really want to reject this approval?
                input#rejectSelection(type='hidden')
              div.modal-footer
                button(type='button' class='btn btn-secondary' data-bs-dismiss='modal') Cancel
                button(type='button' class='btn btn-danger' onclick='confirmRejectProceed()') Reject

        //- Cancel approval confirmation modal
        div.modal.fade#cancelConfirmModal(tabindex='-1' aria-labelledby='cancelConfirmLabel' aria-hidden='true')
          div.modal-dialog
            div.modal-content
              div.modal-header
                h5#cancelConfirmLabel.modal-title Confirm Cancellation
                button(type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close')
              div.modal-body
                | You really want to cancel this approval?
              div.modal-footer
                button(type='button' class='btn btn-secondary' data-bs-dismiss='modal') Keep
                button(type='button' class='btn btn-danger' onclick='confirmCancelProceed()') Cancel approval

        //- Beneficiary modal (shared with beneficiary_list)
        include ./beneficiary_modal

        //- Change Request modal (view + create, shared with IT list)
        include ../IT/forms_it_change_request_modal

        div
          div.row.Not
            div.col-md-4
                label okForm
                input#okForm.form-control(type="text" name="okForm" value=okForm)
            div.col-md-4
                label Messaje
                input#mensaje.form-control(type="text" name="mensaje" value=mensaje)
            div.col-md-4
                label RowID
                input#ID(name='ID' value=detalle.RowID)
          div.row
              div.containerDetails.col-md-8
                div.row
                  div.col-md-4
                    p.titleDetail Company:
                    span 🌐 #{detalle.company}
                  div.col-md-4
                    p.titleDetail Department:
                    span 🏛️ #{detalle.departamento}
                  div.col-md-4
                    if( detalle.solicitante !== detalle.csuscriptor)  
                      p.titleDetail Requester:
                    if(detalle.csuscriptor  && detalle.csuscriptor == detalle.solicitante)  
                      p.titleDetail Requester / Underwriter:
                    img(src=`pic/${userIntegrants.solicitante}.png` class="icon" onerror="this.onerror=null;this.src='pic/default.png';" )
                    span=detalle.solicitante
                div.row
                  div.col-md-4
                    p.titleDetail Process:
                    span 📝 #{detalle.proceso}
                  div.col-md-4
                    p.titleDetail Requested Date:
                    span 🗓️ #{detalle.solicitante_fecha}
                  if(detalle.mmonto || detalle.monto) 
                    div.col-md-4
                        p.titleDetail Amount:
                        i.detail.fas.fa-hand-holding-usd
                        if(detalle.mmonto !==0 && detalle.mmonto !=='' && detalle.mmonto !==null)
                          span  #{detalle.moneda} | #{Number(detalle.mmonto).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                        else
                          span  #{detalle.monto}
                  if(detalle.remittance) 
                    div.col-md-4
                        p.titleDetail Remittance:
                        i.detail.fas.fa-hand-holding-usd
                        span  ##{detalle.remittance} | $#{Number(detalle.mmonto).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                  if(detalle.sir_reference) 
                    if(detalle.csuscriptor !== detalle.solicitante)  
                        div.col-md-4
                            p.titleDetail Underwriter:
                            img(src=`pic/${userIntegrants.csuscriptor}.png` class="icon" onerror="this.onerror=null;this.src='pic/default.png';")
                            span.details_date=detalle.csuscriptor
                    div.col-md-12.mt-3
                      span.titleDetail 🔗 SIR Reference:
                      if(detalle.sir_reference && detalle.sir_reference.split(",").length > 3)
                        i#showMoreBtn.detail.fas.fa-chevron-down(onclick="showMoreOptions()") 
                      - let options = detalle.sir_reference.split(",")
                      table( style="height: 40px; scroll-behavior: smooth; border-radius: 10px; overflow-y: scroll;")
                        tbody#optionsTable
                          each option, index in options
                              tr(style="padding: 0px; margin: 0px;")
                                if index <= 2  
                                  td= option.trim()
                                else
                                  td.hidden= option.trim()
                hr
                div.row
                  if detalle.banco && detalle.banco != 'N/A'
                    div.col-md-4
                      p.titleDetail Bank:  
                      span  🏦 #{detalle.banco}
                  if beneficiario
                    div.col-md-4
                      p.titleDetail Beneficiary:  
                      span(style="cursor: pointer; color: #00586f; text-decoration: underline;" onclick=`openBeneficiaryModal(${beneficiario.beneficiario_id})`)  📄 #{beneficiario.cuenta_banco_beneficiario}
                  if approvalItems && approvalItems.length > 0
                    div.col-md-4
                      p.titleDetail Categorization Items:
                      span(style="cursor:pointer; color:#00586f; text-decoration:underline;" onclick="openCategorizationItemsModal()")  📋 Open Categorization Items
                  div.col-md-10
                    p.titleDetail Description:
                    div.rich-detail-content!=detalle.detalle_proceso
                  //- Cost Center Items
                  if detalle.log_id && detalle.proceso == 'Performance Review Delivery'
                    div.col-md-12
                  if (detalle.log_id && detalle.proceso == 'Change Request')
                    div.col-md-12
                  if detalle.form_id && detalle.proceso == 'Personal Time Off'
                    div.col-md-4
                      p.titleDetail Personal Time Off:
                      span(style="cursor:pointer; color:#00586f; text-decoration:underline;" onclick=`openPtoDetailModal(${detalle.form_id})`)  📋 Open Personal Time Off
                  div.col-md-12
                div.row
                    p #{dbdevteam}
                      if(dbdevteam || userProfile.UsuarioID == 'aguevara'|| userProfile.UsuarioID == 'gguelfi')
                        if(detalle.estado=='Executed' || detalle.estado=='Signed' || detalle.estado=='Execute')
                          div#CopiarArchivosAuditoria(style="display: inline;")
                            i.fas.fa-file-import(style="cursor:pointer;" title="Copy files of audit")
                        if(detalle.estado=='Verify')  
                          div#DivAgregarArchivos(style="display: inline;")
                            i.fas.fa-plus(style="cursor:pointer;" title="Add files of audit")
                div.row         
                  div#ArchivosApproval
                    div#AgregarArchivos.Not
                      div.row
                        div.col-md-8
                          select#SelectArchivosPendientes.form-control(name="SelectArchivosPendientes")
                      div.row
                        div.col-md-4
                            button#ArchivosAddtbtn.form-control( style="background-color: #00586f;color: #e9ecef;") Submit      
                        div.col-md-4
                            button#ArchivosCancelbtn.form-control( style="background-color: #E42217;color: #e9ecef;") Cancel
              div.col-lg-3.col-md-2(style="flex: 1;")
                div.containerDetails-right(style="flex: 1;")
                  if(detalle.verificador!="N/A")
                    div.row
                      div.col-md-12
                        h6#verifier.title_persons Verifier 
                          if(detalle.v_fecha!= null && (detalle.estado == "Rejected") && (lastUser && lastUser.userName == detalle.verificador))
