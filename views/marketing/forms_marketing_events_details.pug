extends ../layout

include ../mixins/floating-input
include ../mixins/floating-select
include ../mixins/floating-textarea
include ../mixins/floating-date
include ../mixins/floating-users
include ../mixins/user-cell-picker
include ../mixins/phone-cell-picker
include ../mixins/contact-cell-picker
include ../mixins/breadcrumb

block layout-content
  div#layoutSidenav_content(style="justify-content: start;")
    main
      div.container-fluid.px-4
        +app-breadcrumb({
          homeHref: '/',
          items: [
            { label: 'Events', href: '/forms_marketing_events_list' },
            { label: `${title}`, active: true }]
        })
        div.col-md-4(style="display: flex; justify-content: space-between; gap: 8px;")
          button.form-control.marketing-action-btn(onclick="GoToApproval()") Approval #{status}
          if (formData.approval_status !== 'Approved' && read !== "true")
            button#updateEventPDF.form-control.marketing-action-btn Update PDF
          else
            button#updateEventPDF.form-control.marketing-action-btn Create new PDF
        ul.event-tabs
          li.event-tab-item
            button.event-tab-btn.active(type="button" data-tab="details" onclick="switchTab('details')")
              i.fas.fa-file-alt
              |  Details
          li.event-tab-item
            button.event-tab-btn(type="button" data-tab="report" onclick="switchTab('report')")
              i.fas.fa-chart-bar
              |  Report
        form(method="put" action="" enctype="multipart/form-data")
      .section-flex
        div.row
            div.col-md-6.Not
                label(for="user_id") Username:
                input#user_id(type="text", name="user_id" value=userProfile.UsuarioID, readonly )
        div.row.Not
            div.col-md-6
                label(for="area_supervisor") Name of area supervisor:
                input#area_supervisor(type="text", name="area_supervisor" value=userProfile.area_supervisor, readonly )
            div.col-md-6
                label(for="suplente") suplente's of area :
                input#suplente(type="text",  name="suplente" value=userProfile.suplente readonly)
        div.row
            div.col-md-6
                +floating-input('Categories', 'category', 'text', false, '', '', '', {value: formData.category, readonly: true})
            div.col-md-3
                +floating-input('Country', 'country', 'text', false, '', '', '', {value: formData.country, readonly: true})
            div.col-md-3
                +floating-input('City', 'city', 'text', false, '', '', '', {value: formData.city, readonly: true})
        div.row
            div.col-md-6
                - var objectiveOptions = formData.category === 'Event Conference' ? [{value: "Strengthen the company's presence and reputation.", label: "Strengthen the company's presence and reputation."}, {value: "Identify potential business opportunities, partnerships, or collaborations.", label: "Identify potential business opportunities, partnerships, or collaborations."}, {value: "Represent the company as a speaker, panelist, or exhibitor.", label: "Represent the company as a speaker, panelist, or exhibitor."}, {value: "Other", label: "Other"}] : [{value: "Strengthening relationships with clients, partners, or suppliers.", label: "Strengthening relationships with clients, partners, or suppliers."}, {value: "Negotiate contracts, agreements, or strategic partnerships.", label: "Negotiate contracts, agreements, or strategic partnerships."}, {value: "Explore new market opportunities and assess potential growth areas.", label: "Explore new market opportunities and assess potential growth areas."}, {value: "Other", label: "Other"}]
                +floating-select('Objectives', 'objective', objectiveOptions, false, 'Select objective', '', '', {defaultValue: formData.objective}, read === "true" || formData.report_status === 'closed')
            div.col-md-3
                +floating-date('Start Date', 'start_date', false, 'DD/MM/YYYY', '', '', {value: formData.start_date, onchange: 'datemins(this);'}, read === "true" || formData.report_status === 'closed')
            div.col-md-3
                +floating-date('End Date', 'end_date', false, 'DD/MM/YYYY', '', '', {value: formData.end_date, onchange: 'datemins(this);'}, read === "true" || formData.report_status === 'closed')
            div(class=`col-md-${formData.category === "Event Conference" ? 3 : 6}`)
                +floating-input('Estimated Budget ($)', 'estimated_budget', 'number', true, 'Example: 1000', '', '', {value: formData.estimated_budget, min: '0', max: '999999', maxlength: '7', oninput: "if(this.value.length > 7) this.value = this.value.slice(0, 7);"}, read === "true" || formData.report_status === 'closed')
            div(class=`col-md-${formData.category === "Event Conference" ? 3 : 6}`)
                +floating-input('Number of Participants', 'participants_number', 'number', true, 'Example: 2', '', '', {value: formData.participants_number, min: '0', max: '999', maxlength: '3', oninput: "if(this.value.length > 3) this.value = this.value.slice(0, 3);"}, read === "true" || formData.report_status === 'closed')
        div.row
          div.col-md-12
            div.floating-input-container
              div.floating-input-wrapper
                if read === "true" || formData.report_status === 'closed'
                  textarea#comments.floating-textarea(name="comments" rows="5" placeholder="Additional comments (Max 500 characters)" maxlength="500" data-required="false" readonly)= formData.comments
                else
                  textarea#comments.floating-textarea(name="comments" rows="5" placeholder="Additional comments (Max 500 characters)" maxlength="500" data-required="false")= formData.comments
                label.floating-label(for="comments") Comments
          div.col-md-6
            - var userOptions = users.map(u => ({value: u.UserID, label: u.Name, department: u.departamento}))
            - var selectedParticipants = participants.map(function(p){ var u = users.find(function(u){ return u.Name === p.name; }); return u ? u.UserID : null; }).filter(Boolean)
            +floating-users('Participants', 'participants', userOptions, selectedParticipants, false, 'Select participants', '', '', {}, true, userProfile.cdepartamento, read === "true" || formData.report_status === 'closed')
        div#MeetingContainer.meeting-planner-section
          div.meeting-planner-header
            span.meeting-planner-icon
              i.fas.fa-calendar-check
            span.meeting-planner-title Meetings
            span#meetingCount.meeting-badge 0
          div#meetingCardsList.meeting-cards-list
          if read !== "true" && formData.report_status !== 'closed'
            div.meeting-add-panel
              div.row.g-2
                div.col-md-4
                  div.floating-input-container
                    div.floating-input-wrapper
                      textarea#meeting_name.floating-textarea(name="meeting_name" rows="2" maxlength="100" placeholder="What is this meeting about?" data-required="false")
                      label.floating-label(for="meeting_name") Meeting Information
                div.col-md-4
                  div.floating-input-container
                    div.floating-input-wrapper
                      textarea#meeting_address.floating-textarea(name="meeting_address" rows="2" maxlength="250" placeholder="Where will it take place?" data-required="false")
                      label.floating-label(for="meeting_address") Meeting Address
                div.col-md-4
                  div.floating-input-container
                    div.floating-input-wrapper
                      textarea#meeting_comments.floating-textarea(name="meeting_comments" rows="2" maxlength="500" placeholder="Any additional notes..." data-required="false")
                      label.floating-label(for="meeting_comments") Comments
              button.btn.meeting-add-btn(type="button" onclick="addMeetingInformationToTable()")
                i.fas.fa-plus
                |  Add Meeting
        if read !== "true" && formData.report_status !== 'closed'
          div.row
              div.col-md-8
                      div.form-check
                          input#requisitionHrCheck.form-check-input(type="checkbox", name="eventUpdateCheck" required)
                          label.form-check-label Are you sure you want to update this form?
          div.row
              div.col-md-2
                button#updateEventForm.form-control.marketing-action-btn Update

      div#tab-report-content(style="display:none;")
        div.container-fluid.px-4.pb-4

          //- ── Event Info Strip ───────────────────────────────────────────
          div.report-event-strip
            div.row.g-2
                div.col-md-3
                  span.strip-label Category
                  span.strip-val #{formData.category}
                div.col-md-3
                  span.strip-label Country / City
                  span.strip-val #{formData.country} — #{formData.city}
                div.col-md-3
                  span.strip-label Dates
                  span.strip-val #{formData.start_date} – #{formData.end_date}
                div.col-md-3
                  span.strip-label Event / Visit
                  span.strip-val #{formData.event_name || formData.visit_name || '—'}

          //- ── Participant Summary ─────────────────────────────────────────
          div.report-section
            div.report-section-header
              i.fas.fa-comment-dots
              span.ms-2 Post-Event Resume
            div.row.g-3
              each participant in participants
                - var resumed = resume.find(function(r){ return r.uingreso === participant.name; })
                - var isOwn   = participant.name === userProfile.UserName
                div.col-md-6.col-lg-4
                  div(class=`summary-card${isOwn ? ' own' : ''}`)
                    div.summary-card-name
                      i.fas.fa-user
                      span.ms-2 #{participant.name}
                    if isOwn && formData.report_status !== 'closed'
                      +floating-textarea('Post-Event Resume', `summary_${participant.name.replace(/\s+/g,'_')}`, true, 'Add your post-event resume...', 'summary-textarea', '', {maxlength: '500', 'data-participant': participant.name}, 4, resumed ? resumed.comments : '')
                      div.summary-char-counter
                        span.summary-char-count= resumed ? resumed.comments.length : 0
                        |  / 500
                      div.summary-actions
                        span.summary-saving(style="display:none;") Saving…
                        button.summary-save-btn(
                          type="button"
                          onclick=`saveResume('${participant.name}', this)`
                        ) Save
                    else
                      div.summary-readonly= resumed ? resumed.comments : 'No comment yet.'

          //- ── Meetings & Action Points ────────────────────────────────────
          div.report-section
            div.report-section-header
              i.fas.fa-tasks
              span.ms-2 Meetings &amp; Action Points

            each meeting, idx in meetings
              - var meetActions = actions.filter(function(a){ return String(a.meeting_id) === String(meeting.id); })
              div.meeting-report-block(data-meeting-id=`${meeting.id}`)
                div.meeting-report-header
                  span.meeting-report-num Meeting ##{idx + 1}
                  span.meeting-report-name — #{meeting.meeting_name}

                div.table-responsive
                  table.actions-table(id=`actionsTable_${meeting.id}`)
                    thead
                      tr
                        th Contact
                        th Meeting Details
                        th Meet Date
                        th.highlight-col Action Points
                        th Due Date
                        th.highlight-col Responsible
                        th Priority
                        th CRM
                        th
                    tbody
                      each action in meetActions
                        tr(
                          data-id=`${action.id}`
                          data-meeting-id=`${meeting.id}`
                          data-event-id=`${formData.id}`
                          class=action.crm_id ? 'row-locked' : ''
                        )
                          - var acList = actionContacts[String(action.id)] || []
                          td
                            div.acb-bar(data-action-id=`${action.id}` data-acb="1")
                              span.acb-chips
                                each ac in acList
                                  span.acb-chip(data-contact-id=`${ac.contact_id}`)
                                    | #{ac.name}#{ac.company_name ? ' (' + ac.company_name + ')' : ''}
                                    if !action.crm_id && formData.report_status !== 'closed'
                                      button.acb-chip-remove(type="button" title="Remove") ×
                              if !action.crm_id && formData.report_status !== 'closed'
                                button.acb-add-btn(type="button")
                                  svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                    path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                    circle(cx="12" cy="7" r="4")
                                div.acb-dropdown.action-chip-dropdown(hidden)
                                  div.acb-dd-header.action-chip-dropdown-header
                                    input.acb-search.action-chip-search(type="text" placeholder="Search contacts...")
                                    button.acb-refresh-btn.action-chip-refresh(type="button" title="Refresh") ⟳
                                    a.acb-new-btn.action-chip-new-link(href=`/badaco-contacts/create`) + New
                                  ul.acb-list.action-chip-list
                          td: input.action-input(type="text"  data-field="meeting_details"   value=`${action.meeting_details || ''}`   placeholder="Details"   readonly=action.crm_id ? true : false)
                          td: input.action-input(type="text"  data-field="meet_date"  value=`${action.meet_date_fmt ? action.meet_date_fmt.split('-').reverse().join('/') : ''}`  placeholder="dd/mm/aaaa"  readonly=action.crm_id ? true : false)
                          td: input.action-input.highlight-input(type="text" data-field="action_points" value=`${action.action_points || ''}` placeholder="Action point" readonly=action.crm_id ? true : false)
                          td: input.action-input(type="text"  data-field="due_date"   value=`${action.due_date_fmt  ? action.due_date_fmt.split('-').reverse().join('/')  : ''}`  placeholder="dd/mm/aaaa"  readonly=action.crm_id ? true : false)
                          td
                            - var arList = actionResponsibles[String(action.id)] || []
                            div.arb-bar(data-action-id=`${action.id}` data-arb="1")
                              span.arb-chips
                                each resp in arList
                                  - var respUser = users.find(function(u){ return u.UserID === resp; })
                                  span.arb-chip(data-user-id=`${resp}`)
                                    img.arb-avatar(src=`/pic/${resp}.png` width="18" height="18" onerror="this.onerror=null;this.src='/pic/default.png';" title=respUser ? respUser.Name : resp)
                                    | #{respUser ? respUser.Name : resp}
                                    if !action.crm_id && formData.report_status !== 'closed'
                                      button.arb-chip-remove(type="button" title="Remove") ×
                              if !action.crm_id && formData.report_status !== 'closed'
                                button.arb-add-btn(type="button")
                                  svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                    path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                    circle(cx="12" cy="7" r="4")
                                div.arb-dropdown.action-chip-dropdown.action-chip-dropdown--users(hidden)
                                  div.action-chip-dropdown-header
                                    input.arb-search.action-chip-search.action-chip-search--full(type="text" placeholder="Search users...")
                                  ul.arb-list.action-chip-list
                          td
                            select.action-input(data-field="priority" disabled=action.crm_id || formData.report_status === 'closed' ? true : false)
                              option(value=""  selected=(!action.priority)) —
                              option(value="0" selected=(action.priority==0)) Normal
                              option(value="1" selected=(action.priority==1)) Important
                              option(value="2" selected=(action.priority==2)) Urgent
                          td
                            if action.crm_id
                              a.crm-badge(href=`/crm_msg?crm_id=${action.crm_id}` target="" title=`CRM #${action.crm_id}`)
                                i.fas.fa-link
                                |  ##{action.crm_id}
                            else
                              span.text-muted —
                          td.row-actions-cell
                            if !action.crm_id && formData.report_status !== 'closed'
                              button.btn-row-remove(type="button" title="Remove" onclick="deleteEventAction(this)")
                                i.fas.fa-times
                      if formData.report_status !== 'closed'
                        tr.new-row-placeholder(data-meeting-id=`${meeting.id}` data-event-id=`${formData.id}`)
                          td
                            div.acb-bar(data-action-id="" data-placeholder="1")
                              span.acb-chips
                              button.acb-add-btn(type="button")
                                svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                  path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                  circle(cx="12" cy="7" r="4")
                              div.acb-dropdown.action-chip-dropdown(hidden)
                                div.acb-dd-header.action-chip-dropdown-header
                                  input.acb-search.action-chip-search(type="text" placeholder="Search contacts...")
                                  button.acb-refresh-btn.action-chip-refresh(type="button" title="Refresh") ⟳
                                  a.acb-new-btn.action-chip-new-link(href=`/badaco-contacts/create` target="") + New
                                ul.acb-list.action-chip-list
                          td: input.action-input(type="text"  data-field="meeting_details"  placeholder="Details")
                          td: input.action-input(type="text"  data-field="meet_date"  placeholder="dd/mm/aaaa")
                          td: input.action-input.highlight-input(type="text" data-field="action_points" placeholder="Action point")
                          td: input.action-input(type="text"  data-field="due_date"   placeholder="dd/mm/aaaa")
                          td
                            div.arb-bar(data-action-id="" data-placeholder="1")
                              span.arb-chips
                              button.arb-add-btn(type="button")
                                svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                  path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                  circle(cx="12" cy="7" r="4")
                              div.arb-dropdown.action-chip-dropdown.action-chip-dropdown--users(hidden)
                                div.action-chip-dropdown-header
                                  input.arb-search.action-chip-search.action-chip-search--full(type="text" placeholder="Search users...")
                                ul.arb-list.action-chip-list
                          td
                            select.action-input(data-field="priority")
                              option(value="0") Normal
                              option(value="1") Important
                              option(value="2") Urgent
                          td
                          td.row-actions-cell
                            button.btn-row-add(type="button" onclick="commitNewRowEvent(this)")
                              i.fas.fa-plus
                              |  Add

          //- ── Close Report ───────────────────────────────────────────────
          if formData.report_status !== 'closed'
            div.report-close-section
              div.report-close-info
                i.fas.fa-info-circle
                |  Closing the report will create CRM cases for every action point that has a due date and responsible person.
              button#closeReportBtn.close-report-btn(type="button" onclick="closeReport()")
                i.fas.fa-flag-checkered
                |  Close Report
          else
            div.alert.alert-success.mt-4(style="border-radius:10px;")
              i.fas.fa-check-circle(style="margin-right:8px;")
              | This report has been closed. CRM cases were created for all eligible action points.

  style.
      h1, h2, h3 {
      color: rgb(0,88,111);
      }
      div.row.results{
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #e9ecef;
        padding: 15px;
        border-radius: 20px;
        margin-top: 20px;
        margin-bottom: 20px;
      }

      .form-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
      }

      .section {
      margin: 20px;
      border: 2px solid rgb(0,88,111);
      padding: 15px;
      border-radius: 20px;
      }
      
      .form-group {
        margin: 15px;
      }
      .marketing-action-btn {
        background-color: #00586f;
        color: #e9ecef;
      }
      .marketing-action-btn:hover {
        background-color: #004256;
        color: #ffffff;
      }
      .section-flex {
        margin: 20px;
        border: 2px solid rgb(0,88,111);
        padding: 15px;
        border-radius: 20px;
        display:"flex";
        flex-wrap: "wrap";
        margin-bottom: 15px;
      }
      label:not(.floating-label):not(.floating-file-label):not(.form-check-label) {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        font-size: .75rem;
        color: black;
      }
      input[type="text"]:not(.floating-input):not(.action-input), input[type="number"]:not(.floating-input):not(.action-input), textarea:not(.floating-textarea):not(.action-input) {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
      }
      input[type="text"]:not(.floating-input):not(.action-input), select:not(.floating-select):not(.action-input) {
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
        width: 95%;
      }
      .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .checkbox-group label {
        display: flex;
        align-items: center;
        font-weight: normal;
      }
      .checkbox-group input[type="checkbox"] {
        margin-right: 5px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
      .actions-table th, .actions-table td { border: none; padding: 4px 5px; }
      th {
        background-color: #f2f2f2;
      }
      span:not(.error-message):not(.chip):not(.placeholder):not(.floating-label) {
        font-size: .8rem;
      }

      /* ── Meeting Planner ── */
      .meeting-planner-section {
        margin: 16px 0;
        border: 1.5px solid #d9edf2;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 1px 6px rgba(0,88,111,0.07);
      }
      .meeting-planner-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 20px;
        border-bottom: 1.5px solid #d9edf2;
      }
      .meeting-planner-icon { color: #00586f; font-size: 1.05rem; }
      .meeting-planner-title {
        font-weight: 700;
        font-size: 0.97rem;
        color: #00586f;
        letter-spacing: 0.01em;
      }
      .meeting-badge {
        background: #00586f;
        color: #fff;
        border-radius: 20px;
        padding: 1px 11px;
        font-size: 0.76rem;
        font-weight: 700;
        min-width: 26px;
        text-align: center;
      }
      .meeting-cards-list { display: flex; flex-direction: column; gap: 0; }
      .meeting-card {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 20px;
        border-bottom: 1px solid #f0f0f0;
        background: #fff;
        transition: background 0.15s;
      }
      .meeting-card:hover { background: #f5fbfd; }
      .meeting-card-accent {
        width: 4px;
        min-height: 52px;
        border-radius: 4px;
        flex-shrink: 0;
        align-self: stretch;
      }
      .meeting-card-body {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 14px;
      }
      .meeting-card-field label {
        font-size: 0.69rem;
        color: #999;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 3px;
        display: block;
      }
      .meeting-card .meeting-card-field textarea {
        width: 100%;
        border: none;
        border-bottom: 1px solid transparent;
        background: transparent;
        resize: none;
        font-size: 0.9rem;
        color: #222;
        outline: none;
        padding: 0;
        min-height: 36px;
        transition: border-color 0.15s, background 0.15s;
        line-height: 1.45;
      }
      .meeting-card .meeting-card-field textarea:not([readonly]):focus {
        border-bottom-color: #00586f;
        background: #f0fafd;
        border-radius: 3px;
        padding: 2px 5px;
      }
      .meeting-card .meeting-card-field textarea[readonly] { color: #555; cursor: default; }
      .meeting-card-remove {
        background: none;
        border: none;
        color: #ccc;
        cursor: pointer;
        padding: 5px;
        border-radius: 6px;
        flex-shrink: 0;
        transition: color 0.15s, background 0.15s;
        margin-top: 2px;
      }
      .meeting-card-remove:hover { color: #dc3545; background: #fff0f0; }
      .meeting-add-panel {
        padding: 16px 20px 14px 20px;
        border-top: 1px dashed #b0d8e0;
      }
      .meeting-add-btn {
        margin-top: 12px;
        background: #00586f;
        color: #fff;
        border-radius: 8px;
        font-size: 0.86rem;
        padding: 7px 22px;
        font-weight: 600;
        border: none;
        transition: background 0.15s, transform 0.1s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
      }
      .meeting-add-btn:hover { background: #004256; color: #fff; transform: translateY(-1px); }
      .meeting-add-btn:active { transform: translateY(0); }

      @media (max-width: 600px) {
        .checkbox-group { flex-direction: column; }
        .meeting-card-body { grid-template-columns: 1fr; }
      }

      /* ── Event Tabs ── */
      .event-tabs {
        list-style: none;
        padding: 0;
        margin: 0 0 0 0;
        display: flex;
        gap: 0;
        border-bottom: 2px solid #d9edf2;
      }
      .event-tab-btn {
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        padding: 9px 22px;
        font-size: .9rem;
        font-weight: 600;
        color: #666;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: color .15s, border-color .15s;
      }
      .event-tab-btn:hover { color: #00586f; }
      .event-tab-btn.active { color: #00586f; border-bottom-color: #00586f; }

      /* ── Report Tab styles ── */
      .report-event-strip {
        background: linear-gradient(90deg,rgba(0,88,111,.07) 0%,#fff 100%);
        border: 1.5px solid #d9edf2; border-radius: 12px;
        padding: 16px 24px; margin: 20px 0 24px;
      }
      .strip-label { display:block; font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#999; }
      .strip-val   { display:block; font-size:.97rem; font-weight:600; color:#003d4f; }
      .report-section { margin-bottom: 28px; }
      .report-section-header {
        display:flex; align-items:center; gap:8px; font-weight:700; font-size:1rem; color:#00586f;
        border-bottom:2px solid #d9edf2; padding-bottom:8px; margin-bottom:16px;
      }
      .summary-card { border:1.5px solid #e0e0e0; border-radius:10px; padding:14px 16px; background:#fff; height:100%; box-shadow:0 1px 4px rgba(0,88,111,.05); }
      .summary-card-name { font-weight:700; font-size:.88rem; color:#00586f; margin-bottom:10px; }
      .summary-textarea { width:100%; border:1px solid #d0e8ef; border-radius:6px; padding:8px 10px; font-size:.88rem; resize:vertical; outline:none; transition:border-color .15s; }
      .summary-textarea:focus { border-color:#00586f; }
      .summary-actions { display:flex; align-items:center; gap:10px; margin-top:8px; }
      .summary-char-counter { font-size:.75rem; color:#999; text-align:right; margin-top:-4px; }
      .summary-saving { font-size:.75rem; color:#999; }
      .summary-save-btn { background:#00586f; color:#fff; border:none; border-radius:6px; padding:4px 16px; font-size:.82rem; font-weight:600; cursor:pointer; }
      .summary-save-btn:hover { background:#004256; }
      .summary-readonly { font-size:.87rem; color:#555; font-style:italic; min-height:48px; }
      .meeting-report-block { margin-bottom:24px; border:1.5px solid #d9edf2; border-radius:10px; overflow:hidden; }
      .meeting-report-header { padding:10px 18px; font-size:.92rem; }
      .meeting-report-num  { font-weight:800; color:#00586f; font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; margin-right:4px; }
      .meeting-report-name { font-weight:600; color:#222; }
      .meeting-report-addr { font-size:.82rem; color:#888; }
      .actions-table { width:100%; border-collapse:collapse; font-size:.82rem; min-width:1100px; }
      .actions-table thead th { background:#f5f5f5; border:none; padding:7px 8px; font-size:.7rem; text-transform:uppercase; letter-spacing:.04em; color:#666; white-space:nowrap; font-weight:700; }
      .actions-table th.highlight-col { color:#00586f; }
      .actions-table tbody tr { border-bottom:none; transition:background .1s; }
      .actions-table tbody tr:hover { background:#f8fdff; }
      .actions-table tbody tr.row-locked { background:#fafafa; }
      .actions-table td { padding:4px 5px; vertical-align:middle; border:none; }
      .action-input { width:100%; border:none; border-bottom:1px solid transparent; background:transparent; font-size:.82rem; padding:4px 5px; outline:none; border-radius:3px; transition:border-color .15s,background .15s; min-width:72px; }
      .action-input:focus { border-bottom-color:#00586f; background:#f0fafd; }
      .action-input[readonly],.action-input:disabled { color:#555; cursor:default; background:transparent; }
      .highlight-input { font-weight:600; }
      .crm-badge { display:inline-flex; align-items:center; gap:4px; background:#e6f4f1; color:#00586f; border-radius:12px; padding:2px 8px; font-size:.75rem; font-weight:700; text-decoration:none; white-space:nowrap; }
      .crm-badge:hover { background:#cdeae5; color:#003d4f; }
      .row-actions-cell { white-space:nowrap; text-align:center; }
      .btn-row-remove { background:none; border:none; color:#ccc; cursor:pointer; border-radius:4px; padding:3px 6px; transition:color .15s,background .15s; }
      .btn-row-remove:hover { color:#dc3545; background:#fff0f0; }
      .btn-row-add { background:#00586f; color:#fff; border:none; border-radius:6px; padding:4px 12px; font-size:.78rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:5px; }
      .btn-row-add:hover { background:#004256; }
      .new-row-placeholder { background:#f8fdff; }
      /* ── Action Responsible Bar ── */
      .arb-bar { display:flex; flex-wrap:wrap; align-items:center; gap:4px; min-width:100px; }
      .arb-chips { display:flex; flex-wrap:wrap; gap:3px; }
      .arb-chip { display:inline-flex; align-items:center; gap:4px; background:#e8f4fb; color:#1a5276; border-radius:12px; padding:2px 8px 2px 3px; font-size:.74rem; font-weight:600; white-space:nowrap; }
      .arb-avatar { border-radius:50%; object-fit:cover; flex-shrink:0; display:block; }
      .arb-chip-remove { background:none; border:none; cursor:pointer; color:#888; font-size:.85rem; padding:0 0 0 3px; line-height:1; }
      .arb-chip-remove:hover { color:#dc3545; }
      .arb-add-btn { background:none; border:1px solid #ccc; color:#999; border-radius:10px; padding:1px 7px; font-size:.75rem; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; }
      .arb-add-btn:hover { border-color:#888; color:#555; background:#f5f5f5; }
      .arb-list li { padding:6px 12px; cursor:pointer; font-size:.82rem; display:flex; align-items:center; gap:8px; }
      .arb-list li:hover:not(.arb-no-results):not(.arb-already) { background:#f0fafd; }
      .arb-list li.arb-already { color:#aaa; cursor:default; }
      .arb-no-results { color:#aaa; font-style:italic; padding:8px 12px; }
      .acb-bar { display:flex; flex-wrap:wrap; align-items:center; gap:4px; min-width:120px; }
      .acb-chips { display:flex; flex-wrap:wrap; gap:3px; }
      .acb-chip { display:inline-flex; align-items:center; gap:3px; background:#e6f4f1; color:#00586f; border-radius:12px; padding:2px 8px 2px 8px; font-size:.74rem; font-weight:600; white-space:nowrap; }
      .acb-chip-remove { background:none; border:none; cursor:pointer; color:#888; font-size:.85rem; padding:0 0 0 3px; line-height:1; }
      .acb-chip-remove:hover { color:#dc3545; }
      .acb-add-btn { background:none; border:1px solid #ccc; color:#999; border-radius:10px; padding:1px 7px; font-size:.75rem; cursor:pointer; white-space:nowrap; font-weight:500; }
      .acb-add-btn:hover { border-color:#888; color:#555; background:#f5f5f5; }
      .acb-list li { padding:6px 12px; cursor:pointer; font-size:.82rem; display:flex; flex-direction:column; }
      .acb-list li:hover:not(.acb-no-results):not(.acb-already) { background:#f0fafd; }
      .acb-list li.acb-already { color:#aaa; cursor:default; }
      .acb-item-company { font-size:.72rem; color:#888; }
      .acb-no-results { color:#aaa; font-style:italic; padding:8px 12px; }
      .report-close-section { display:flex; align-items:center; gap:20px; background:#fff8e1; border:1.5px solid #ffe082; border-radius:10px; padding:16px 24px; margin-top:16px; }
      .report-close-info { flex:1; font-size:.87rem; color:#5d4037; display:flex; align-items:center; gap:8px; }
      .close-report-btn { background:#00586f; color:#fff; border:none; border-radius:8px; padding:10px 28px; font-weight:700; font-size:.9rem; display:inline-flex; align-items:center; gap:8px; cursor:pointer; white-space:nowrap; }
      .close-report-btn:hover { background:#004256; }
      .close-report-btn:disabled { background:#9e9e9e; cursor:not-allowed; }

