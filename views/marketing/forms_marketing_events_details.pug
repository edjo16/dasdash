      function areParticipantsEqual(initialParticipants, currentParticipants) {
            if(initialParticipants.length !== currentParticipants.length) {
              return false;
            }
            const initialNames = initialParticipants.map(p => p.name).sort();
            const currentNames = currentParticipants.map(p => p.name).sort();
            return initialNames.every((name, index) => name === currentNames[index]);
      }
      function areMeetingsEqual(initialMeetings, currentMeetings) {
            if(initialMeetings.length !== currentMeetings.length) {
              return false;
            }
            return initialMeetings.every((initialMeeting, index) => {
              const currentMeeting = currentMeetings[index];
              return initialMeeting.meeting_name === currentMeeting.meeting_name &&
                     initialMeeting.meeting_address === currentMeeting.meeting_address &&
                     initialMeeting.meeting_comments === currentMeeting.meeting_comments;
            });
      }
      $("#updateEventForm").click(async function(e) {
        e.preventDefault();
        if (reportStatus === 'closed') {
          launch_toast('Cannot update: Report is closed', 2);
          return;
        }
        const currentParticipants = getParticipantsFromUI();
        let meetings = meetingsArray
        const pathArray = window.location.pathname.split('/');
        const id = pathArray[pathArray.length - 1];
        const user = document.getElementById('user_id').value;
        const objective = document.getElementById('objective').value;
        const estimatedBudget = document.getElementById('estimated_budget').value;
        const participants_number = document.getElementById('participants_number').value;
        const comments = document.getElementById('comments').value;
        const startDate = document.getElementById('start_date').value;
        const endDate = document.getElementById('end_date').value;
        const categories = document.getElementById('category').value;
        const check = document.getElementById('requisitionHrCheck').checked;
        const formData = {
          user: user,
          objective,
          estimated_budget: parseFloat(estimatedBudget),
          participants_number: parseInt(participants_number),
          comments,
          start_date: startDate,
          end_date: endDate,
          participants: currentParticipants,
          meetings: meetingsArray,
          initial_events: initialEvents
        };
        let send = true;

        const participants = areParticipantsEqual(initialParticipantsArray, formData.participants);
        const meetingsVerification = areMeetingsEqual(inicialMeetingsArray, formData.meetings);

        if (check) {
          send = true;
          if (objective === formData.objective && 
            Number(formData.estimated_budget) === Number(initialEvents.formData.estimated_budget) &&
            Number(formData.participants_number) === Number(initialEvents.formData.participants_number) &&
            formData.comments === initialEvents.formData.comments && 
            formData.start_date === initialEvents.formData.start_date && 
            formData.end_date === initialEvents.formData.end_date &&
            participants 
            && meetingsVerification
            ) {
              launch_toast("Theres no changes to update", 2);
              send = false;
          }
        } else {
          send = false;
          launch_toast("The form is not checked", 2);
        }

        if (send) {
          fetch(`/forms_marketing_events/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData),
          })
          .then(response => response.json())
          .then(data => {
            const check = document.getElementById('requisitionHrCheck');
            check ? check.checked = false : null;
            launch_toast("Event updated successfully", 1);
            // Sync tracking state to saved values — no page reload needed
            initialParticipantsArray = JSON.parse(JSON.stringify(formData.participants));
            inicialMeetingsArray = JSON.parse(JSON.stringify(formData.meetings));
            if (initialEvents && initialEvents.formData) {
              initialEvents.formData.objective          = formData.objective;
              initialEvents.formData.estimated_budget   = formData.estimated_budget;
              initialEvents.formData.participants_number = formData.participants_number;
              initialEvents.formData.comments           = formData.comments;
              initialEvents.formData.start_date         = formData.start_date;
              initialEvents.formData.end_date           = formData.end_date;
            }
          })
          .catch(error => {
            console.log(error);
            launch_toast("Error updating the event", 2);
          });
        }

      });
