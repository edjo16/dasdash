      // ── Tab switching ────────────────────────────────────────────────
      function switchTab(tabName) {
        const containerFluid = document.querySelector('#layoutSidenav_content main .container-fluid');
        const reportPane     = document.getElementById('tab-report-content');
        if (containerFluid) {
          let sib = containerFluid.nextElementSibling;
          while (sib) {
            const tag = sib.tagName.toLowerCase();
            if (tag !== 'style' && tag !== 'script') {
              if (sib === reportPane) {
                sib.style.display = tabName === 'report' ? '' : 'none';
              } else {
                sib.style.display = tabName === 'details' ? '' : 'none';
              }
            }
            sib = sib.nextElementSibling;
          }
        }
        document.querySelectorAll('.event-tab-btn').forEach(function(btn) {
          btn.classList.toggle('active', btn.dataset.tab === tabName);
        });
      }
      // ── Report helpers ───────────────────────────────────────────────
      const eventId      = !{JSON.stringify(formData.id)};
      const currentUID   = !{JSON.stringify(userProfile.UsuarioID)};
      const departamento = !{JSON.stringify(userProfile.Dep)};
      const reportStatus = !{JSON.stringify(formData.report_status)};
      // ── Summary char counter ──────────────────────────────────────────
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.summary-card.own .floating-textarea').forEach(function(ta) {
          var counter = ta.closest('.summary-card').querySelector('.summary-char-count');
          if (!counter) return;
          ta.addEventListener('input', function() {
            var len = ta.value.length;
            counter.textContent = len;
            counter.style.color = len > 500 ? '#dc3545' : (len > 450 ? '#e67e22' : '#999');
          });
        });
      });

      function saveResume(participantName, btn) {
        if (reportStatus === 'closed') {
          launch_toast('Cannot edit: Report is closed', 2);
          return;
        }
        const key = participantName.replace(/\s+/g,'_');
        const ta  = document.getElementById('summary_' + key);
        if (!ta) return;
        // Run mixin validation
        const validateFn = window['validateInput_summary_' + key];
        if (validateFn && !validateFn()) return;
        // Manual guard for empty + maxlength
        if (!ta.value.trim()) {
          launch_toast('Post-Event Resume is required', 2);
          return;
        }
        if (ta.value.length > 500) {
          launch_toast('Maximum 500 characters allowed', 2);
          return;
        }
        const savingEl = ta.closest('.summary-card').querySelector('.summary-saving');
        if (savingEl) savingEl.style.display = 'inline';
        btn.disabled = true;
        fetch('/events_resume/' + eventId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ event_id: eventId, uingreso: participantName, comments: ta.value })
        })
        .then(r => r.json())
        .then(function() {
          if (savingEl) savingEl.style.display = 'none';
          btn.disabled = false;
          launch_toast('Summary saved', 1);
        })
        .catch(function() {
          if (savingEl) savingEl.style.display = 'none';
          btn.disabled = false;
          launch_toast('Error saving summary', 2);
        });
      }

      function commitNewRowEvent(btn) {
        console.log("ejecutado")
        if (reportStatus === 'closed') {
          launch_toast('Cannot add actions: Report is closed', 2);
          return;
        }
        const row = btn.closest('tr.new-row-placeholder');
        if (!row) return;
        const meetingId = row.dataset.meetingId;
        const evtId     = row.dataset.eventId;
        
        // Validate meeting_id exists
        if (!meetingId || meetingId === '') {
          launch_toast('Please save the event first to add action points', 2);
          return;
        }
        
        const data = { user_id: currentUID, meeting_id: meetingId, event_id: evtId };
        row.querySelectorAll('[data-field]').forEach(function(el) {
          data[el.dataset.field] = el.value || null;
        });
        const acbBar = row.querySelector('.acb-bar');
        const arbBar = row.querySelector('.arb-bar');
        const selectedContactIds = acbBar ? window.eventDetailACB.getSelectedContactIds(acbBar) : [];
        const selectedUserIds    = arbBar ? window.eventDetailARB.getSelectedUserIds(arbBar) : [];
        // ── Required field validation ────────────────────────────────────
        const missing = [];
        if (!selectedContactIds.length) missing.push('Contact');
        if (!data.meeting_details)      missing.push('Meeting Details');
        if (!data.meet_date)            missing.push('Meet Date');
        if (missing.length) {
          launch_toast('Required: ' + missing.join(', '), 2);
          if (!selectedContactIds.length && acbBar) {
            const ab = acbBar.querySelector('.acb-add-btn');
            if (ab) { ab.style.outline = '2px solid #dc3545'; setTimeout(function(){ ab.style.outline = ''; }, 2500); }
          }
          if (!data.meeting_details) {
            const md = row.querySelector('[data-field="meeting_details"]');
            if (md) { md.style.outline = '2px solid #dc3545'; setTimeout(function(){ md.style.outline = ''; }, 2500); }
          }
          if (!data.meet_date) {
            const dt = row.querySelector('[data-field="meet_date"]');
            if (dt) { dt.style.outline = '2px solid #dc3545'; setTimeout(function(){ dt.style.outline = ''; }, 2500); }
          }
          return;
        }
        // ─────────────────────────────────────────────────────────────────
        fetch('/events_meeting_action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(function(res) {
          if (!res.id) { launch_toast('Error saving action', 2); return; }
          const actionId = res.id;
          // Save contacts + responsibles in parallel
          Promise.all([
            ...selectedContactIds.map(function(cid) {
              return fetch('/events_action_contact', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ meeting_action_id: actionId, contact_id: cid })
              });
            }),
            ...selectedUserIds.map(function(uid) {
              return fetch('/events_action_responsible', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ meeting_action_id: actionId, responsible: uid })
              });
            })
          ]).then(function() {
            const tbody = row.closest('tbody');
            if (!tbody) {
              launch_toast('Action added', 1);
              return;
            }
            const newTr = document.createElement('tr');
            newTr.dataset.id        = actionId;
            newTr.dataset.meetingId = meetingId;
            newTr.dataset.eventId   = evtId;
            var _PSVG = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
            // contact chips
            const contacts = window.contactCellPickerData || [];
            var contactChips = '';
            selectedContactIds.forEach(function(cid) {
              var c = contacts.find(function(x) { return String(x.contact_id) === String(cid); });
              if (c) contactChips += `<span class="acb-chip" data-contact-id="${cid}">${c.name}${c.company_name ? ' (' + c.company_name + ')' : ''}<button class="acb-chip-remove" type="button" title="Remove">×</button></span>`;
            });
            var contactCell = `<td><div class="acb-bar" data-action-id="${actionId}"><span class="acb-chips">${contactChips}</span><button class="acb-add-btn" type="button">${_PSVG}</button><div class="acb-dropdown action-chip-dropdown" hidden><div class="acb-dd-header action-chip-dropdown-header"><input class="acb-search action-chip-search" type="text" placeholder="Search contacts..."><button class="acb-refresh-btn action-chip-refresh" type="button" title="Refresh">⟳</button><a class="acb-new-btn action-chip-new-link" href="/badaco-contacts/create">+ New</a></div><ul class="acb-list action-chip-list"></ul></div></div></td>`;
            // responsible chips
            const allUsers = window.userCellPickerUsersData || [];
            var respChips = '';
            selectedUserIds.forEach(function(uid) {
              var u = allUsers.find(function(x) { return String(x.id) === String(uid); });
              if (u) respChips += `<span class="arb-chip" data-user-id="${uid}"><img class="arb-avatar" src="/pic/${uid}.png" width="18" height="18" onerror="this.onerror=null;this.src='/pic/default.png';" title="${u.name}">${u.name}<button class="arb-chip-remove" type="button" title="Remove">×</button></span>`;
            });
            var respCell = `<td><div class="arb-bar" data-action-id="${actionId}"><span class="arb-chips">${respChips}</span><button class="arb-add-btn" type="button">${_PSVG}</button><div class="arb-dropdown action-chip-dropdown action-chip-dropdown--users" hidden><div class="action-chip-dropdown-header"><input class="arb-search action-chip-search action-chip-search--full" type="text" placeholder="Search users..."></div><ul class="arb-list action-chip-list"></ul></div></div></td>`;
            const fields = ['meeting_details','meet_date','action_points','due_date'];
            const placeholders = {'meet_date':'dd/mm/aaaa','due_date':'dd/mm/aaaa','meeting_details':'Details','action_points':'Action point'};
            const highlights = ['action_points'];
            let cells = contactCell;
            fields.forEach(function(f) {
              const hi = highlights.includes(f) ? ' highlight-input' : '';
              const ph = placeholders[f] ? ` placeholder="${placeholders[f]}"` : '';
              cells += `<td><input class="action-input${hi}" type="text" data-field="${f}" value="${(data[f]||'').replace(/"/g,'&quot;')}"${ph}></td>`;
            });
            cells += respCell;
            const pVal = data.priority || '';
            cells += `<td><select class="action-input" data-field="priority"><option value="0"${pVal=='0'?' selected':''}>Normal</option><option value="1"${pVal=='1'?' selected':''}>Important</option><option value="2"${pVal=='2'?' selected':''}>Urgent</option></select></td>`;
            cells += `<td><span class="text-muted">—</span></td>`;
            cells += `<td class="row-actions-cell"><button class="btn-row-remove" type="button" title="Remove" onclick="deleteEventAction(this)"><i class="fas fa-times"></i></button></td>`;
            newTr.innerHTML = cells;
            tbody.insertBefore(newTr, row);
            window.eventDetailACB.initAll();
            window.eventDetailARB.initAll();
            initActionDatePickers(newTr);
            // clear placeholder
            row.querySelectorAll('[data-field]').forEach(function(el) { el.value = ''; });
            if (acbBar) { acbBar.querySelector('.acb-chips').innerHTML = ''; delete acbBar.dataset.acbDone; window.eventDetailACB.initAll(); }
            if (arbBar) { arbBar.querySelector('.arb-chips').innerHTML = ''; delete arbBar.dataset.arbDone; window.eventDetailARB.initAll(); }
            launch_toast('Action added', 1);
          }).catch(function(err) {
            console.error('Error saving contacts/responsibles:', err);
            launch_toast('Action created but error saving details', 2);
          });
        })
        .catch(function(err) { 
          console.error('Error saving action:', err);
          launch_toast('Error saving action', 2); 
        });
      }

      function deleteEventAction(btn) {
        if (reportStatus === 'closed') {
          launch_toast('Cannot delete: Report is closed', 2);
          return;
        }
        const row = btn.closest('tr');
        if (!row || !row.dataset.id) return;
        showModal(
          'Are you sure you want to remove this action point? This action <strong>cannot be undone</strong>.',
          function() {
            fetch('/events_meeting_action/' + row.dataset.id, {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ user_id: currentUID })
            })
            .then(r => r.json())
            .then(function() {
              row.remove();
              launch_toast('Action removed', 1);
            })
            .catch(function() { launch_toast('Error removing action', 2); });
          },
          null,
          { title: 'Remove Action Point?', okText: 'Yes, remove it', cancelText: 'Cancel', type: 'danger' }
        );
      }

      // Auto-save action row on blur
      document.addEventListener('blur', function(e) {
        const el = e.target;
        if (!el.classList.contains('action-input')) return;
        if (reportStatus === 'closed') return; // Don't save if report is closed
        const row = el.closest('tr');
        if (!row || !row.dataset.id || row.classList.contains('new-row-placeholder')) return;
        const body = { user_id: currentUID };
        row.querySelectorAll('[data-field]').forEach(function(inp) { body[inp.dataset.field] = inp.value || null; });
        fetch('/events_meeting_action/' + row.dataset.id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        }).catch(function() { launch_toast('Error saving action', 2); });
      }, true);

      function closeReport() {
        showModal(
          'This will create CRM cases for all eligible action points and <strong>cannot be undone</strong>.',
          function() {
            const btn = document.getElementById('closeReportBtn');
            btn.disabled = true;
            fetch('/events_close_report/' + eventId, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ user_id: currentUID, departamento: departamento })
            })
            .then(r => r.json())
            .then(function(res) {
              launch_toast('Report closed. ' + (res.crm_created || 0) + ' CRM case(s) created.', 1);
              setTimeout(function() { window.location.reload(); }, 1500);
            })
            .catch(function() {
              document.getElementById('closeReportBtn').disabled = false;
              launch_toast('Error closing report', 2);
            });
          },
          null,
          { title: 'Close the Report?', okText: 'Yes, close it', cancelText: 'Cancel', type: 'danger' }
        );
      }
      $("#updateEventPDF").click(async function(e) {
        const pathArray = window.location.pathname.split('/');
        const id = pathArray[pathArray.length - 1];
          fetch(`/post_pdf_forms_marketing_events/${id}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
          })
          .then(response => response.json())
          .then(data => {
            if (data.result === 1) {
              launch_toast("PDF updated successfully", 1);
            }else{
              launch_toast("Error updating the PDF", 2);
            }
          })
          .catch(error => {
            console.log(error);
            launch_toast("Error updating the PDF", 2);
          });
      })
    $(document).ready(function(){
        $("#start_date").datepicker({
            dateFormat: "dd/mm/yy",
            minDate: 1,
            onSelect: function(selectedDate) {
                const startDate = $(this).datepicker("getDate");
                const endDate = $("#end_date").datepicker("getDate");
                if (endDate && endDate < startDate) {
                    $("#end_date").datepicker("setDate", startDate);
                }
            }
        });
        $("#end_date").datepicker({
            dateFormat: "dd/mm/yy",
            minDate: 1,
            onSelect: function(selectedDate) {
                const startDate = $("#start_date").datepicker("getDate");
                const endDate = $(this).datepicker("getDate");
                if (startDate && endDate < startDate) {
                    $("#start_date").datepicker("setDate", endDate);
                }
            }
        });
        initActionDatePickers(document);
    });
    function initActionDatePickers(context) {
      $(context).find('input[data-field="meet_date"]:not([readonly]), input[data-field="due_date"]:not([readonly])').each(function() {
        if (!$(this).hasClass('hasDatepicker')) {
          $(this).datepicker({ dateFormat: "dd/mm/yy" });
        }
      });
    }