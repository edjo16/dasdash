          </div>
          <div class="meeting-card-field">
            <label>Meeting Address</label>
            <textarea name="meeting_address" data-index="${index}" onchange="updatethis(this)" maxlength="250">${meetingAddress}</textarea>
          </div>
          <div class="meeting-card-field">
            <label>Comments</label>
            <textarea name="meeting_comments" data-index="${index}" onchange="updatethis(this)" maxlength="500">${meetingComments}</textarea>
