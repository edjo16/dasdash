        </button>`;
      document.getElementById('meetingCardsList').appendChild(card);

      document.getElementById('meeting_name').value = '';
      document.getElementById('meeting_address').value = '';
      document.getElementById('meeting_comments').value = '';
      updateMeetingCount();
    }
    function updateMeetingCount() {
      const badge = document.getElementById('meetingCount');
      if (badge) badge.textContent = meetingsArray.length;
    }
    function updateObjectives() {
        const objectives = {
          ['Event Conference']: [
            "Strengthen the company's presence and reputation.",
            "Identify potential business opportunities, partnerships, or collaborations.",
            "Represent the company as a speaker, panelist, or exhibitor.",
            "Other"
          ],
          ['Market Visit']: [
            "Strengthening relationships with clients, partners, or suppliers.",
            "Negotiate contracts, agreements, or strategic partnerships.",
            "Explore new market opportunities and assess potential growth areas.",
            "Other"
          ]
        };


        const category = document.getElementById('category').value;
        const eventNameField = document.getElementById('event_name');
        const eventField = document.getElementById('eventField');
        const eventField1 = document.getElementById('eventField1');
        const eventField2 = document.getElementById('eventField2');
        const visitNameField = document.getElementById('visitName');
        const visitName = document.getElementById('visit_name');
        const otherEvent = document.getElementById('OtherEvent');
        const objective_other = document.getElementById('OtherObjetive');
        const objective_otherfield = document.getElementById('objective_other');

        if (category === 'Event Conference') {
          eventField.style.display = 'block';
          objective_other.style.display = 'none';
          objective_otherfield.value = '';
          eventNameField.style.display = 'block';
          eventNameField.setAttribute('required', 'required');
          eventField1.className = 'col-md-3';
          eventField2.className = 'col-md-3';
          visitNameField.style.display = 'none';
          visitName.removeAttribute('required');
          otherEvent.style.display = 'none';
          visitName.value = '';
        } else {
          eventField.style.display = 'block';
          objective_other.style.display = 'none';
          objective_otherfield.value = '';
          eventField1.className = 'col-md-6';
          otherEvent.style.display = 'none';
          eventField2.className = 'col-md-6';
          eventField.style.display = 'none';
          eventNameField.style.display = 'none';
          eventNameField.removeAttribute('required');
          eventNameField.value = '';
          visitName.setAttribute('required', 'required');
          visitNameField.style.display = 'block';
        }
        const objectiveSelect = document.getElementById('objective');
        objectiveSelect.innerHTML = '<option value="" disabled selected>Select objective</option>';

        if (objectives[category]) {
          objectives[category].forEach(objective => {
            const option = document.createElement('option');
            option.value = objective;
            option.textContent = objective;
            objectiveSelect.appendChild(option);
          });
      }
    }
    function handleOtherSelection(selectElement, inputId) {
        const column = document.getElementById(inputId);
      if(inputId === "OtherEvent"){
          const inputField = document.getElementById('event_name_other');

          if (selectElement.value === "Other") {
              selectElement.parentNode.classList.remove("col-md-6");
              selectElement.parentNode.classList.add("col-md-3");
              column.style.display = "block";
              inputField.setAttribute("required", "required");
          } else {
              column.style.display = "none";
              selectElement.parentNode.classList.remove("col-md-3");
              selectElement.parentNode.classList.add("col-md-6");
              inputField.removeAttribute("required");
              inputField.value = "";
          }
          
      } else{
          const inputField = document.getElementById('objective_other');
          if (selectElement.value === "Other") {
              selectElement.parentNode.classList.remove("col-md-6");
              selectElement.parentNode.classList.add("col-md-3");
              column.style.display = "block";
              inputField.setAttribute("required", "required");
          } else {
              column.style.display = "none";
              selectElement.parentNode.classList.remove("col-md-3");
              selectElement.parentNode.classList.add("col-md-6");
              inputField.removeAttribute("required");
              inputField.value = "";
          }
      }
    }
      function updatethis(textarea) {
        const card = textarea.closest('.meeting-card');
        const index = parseInt(card.dataset.index);
        if (textarea.name.includes('meeting_name'))    meetingsArray[index].meeting_name    = textarea.value;
        if (textarea.name.includes('meeting_address')) meetingsArray[index].meeting_address = textarea.value;
        if (textarea.name.includes('meeting_comments'))meetingsArray[index].meeting_comments= textarea.value;
      }
    $(document).ready(function(){
        $("#start_date").datepicker({
            dateFormat: "dd/mm/yy",
            onSelect: function(selectedDate) {
                const startDate = $(this).datepicker("getDate");
                const endDate = $("#end_date").datepicker("getDate");
                if (endDate && endDate < startDate) {
                    $("#end_date").datepicker("setDate", startDate);
                }
                $("#end_date").datepicker("option", "minDate", startDate);
            }
        });
        $("#end_date").datepicker({
            dateFormat: "dd/mm/yy",
            onSelect: function(selectedDate) {
                const startDate = $("#start_date").datepicker("getDate");
                const endDate = $(this).datepicker("getDate");
                if (startDate && endDate < startDate) {
                    $("#start_date").datepicker("setDate", endDate);
                }
            }
        });
    });