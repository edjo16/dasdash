extends ../layout

include ../mixins/floating-input
include ../mixins/floating-select
include ../mixins/floating-textarea
include ../mixins/floating-date
include ../mixins/floating-users
include ../mixins/floating-file

block layout-content
  div#layoutSidenav_content(style="justify-content: start;")
    main
      div.container-fluid.px-4
        a(href="#" onclick="goBack()" style="color:#212529")
            i.fas.fa-chevron-left
            span(href="#" onclick="goBack()" style="padding-left: 0.5rem;") Back
        h1#titlename.mt-4 #{title}
        ol.breadcrumb.mb-4
          li.breadcrumb-item.active This form is designated to create an event in the organization.
    form#form_marketing_events(method="post" action="" enctype="multipart/form-data")
      .section-flex
        div.row.Not
                div.col-md-6
                    label Master Form
                    input#mform.form-control(type="number" name="mform" value=mform[0].id readonly)
        div.row.Not
                div.col-md-4
                    label Department Start
                    input#id_dep_inicio.form-control(type="text" name="id_dep_inicio" value=userProfile.Dep)
                div.col-md-4
                    label Flow Type
                    input#ctipo.form-control(type="text" name="ctipo" value=approvalFlow.ctipo_flujo)
                div.col-md-4
                    label User
                    input#xnombre.form-control(type="text" name="xnombre" value=userProfile.UserName)
                div.col-md-4
                    label Username
                    input#username.form-control(type="text" name="username" value=userProfile.UsuarioID)
                div.col-md-4
                    label okForm
                    input#okForm.form-control(type="text" name="okForm" value=okForm)
                div.col-md-4
                    label Messaje
                    input#mensaje.form-control(type="text" name="mensaje" value=mensaje)
                div.col-md-4
                    label Status
                    input#estado.form-control(type="text" name="estado" value="Verify")
                div.col-md-4
                    label Compañias
                    input#ccompania.form-control(type="text" name="ccompania" value=userMenu.compania)
                div.col-md-4
                    label Company
                    input#compania.form-control(name="compania"  value=approvalFlow.xnombre required)
                    input#ccompania.form-control(type="text" name="ccompania" value=userMenu.compania)
                div.col-md-4
                    label Approvals
                    input#approvals_select.form-control(name="approvals_select"  value=approvalFlow.nombre required)
                div.col-md-4
                    label Process
                    input#proceso.form-control(name="proceso"  value=approvalFlow.xprocesos required)
        div.row.Not
                div.col-md-6
                    label Verifier
                    input#verificador.form-control(name="verificador" value=approvalFlow.uverificador readonly)
                div.col-md-4
                    label Approver
                    input#aprobador.form-control(name="aprobador" value=approvalFlow.uaprobador readonly)
                div.col-md-4
                    label Signer
                    input#firmante.form-control(name="firmante"  value=approvalFlow.ufirmante readonly)
                div.col-md-4
                    label Operator
                    input#operador.form-control(name="operador"  value=approvalFlow.uoperador readonly)
                div.col-md-6
                    label Executor
                    input#ejecutor.form-control(name="ejecutor"  value=approvalFlow.uejecutor readonly)
        div.row.Not
            div.col-md-6
                label(for="collaborator_name") Collaborator's name:
                input#collaborator_name(type="text", name="collaborator_name", value=userMenu.Name, readonly)
            div.col-md-6
                label(for="collaborator_title") Collaborator's job Tittle:
                input#collabjobTitle(type="text", name="collaborator_title" value=userMenu.xcargo, readonly)
        div.row
            div.col-md-6.Not
                label(for="manager") Username:
            div.col-md-6.Not
                label(for="department") department:
        div.row.Not
            div.col-md-6
                label(for="area_supervisor") Name of area supervisor:
                input#area_supervisor(type="text", name="area_supervisor" value=userProfile.area_supervisor, readonly )
            div.col-md-6
                label(for="suplente") suplente's of area :
                input#suplente(type="text",  name="suplente" value=userProfile.suplente readonly)
        div.row
            div.col-md-6
                +floating-select('Categories', 'category', [{value: 'Event Conference', label: 'Event Conference'}, {value: 'Market Visit', label: 'Market Visit'}], true, 'Category', '', '', {onchange: 'updateObjectives()'})
            div.col-md-3
                - var countryOptions = countries.map(c => ({value: c.xnombre_pais_ingles, label: c.xnombre_pais_ingles}))
                +floating-select('Country', 'country', countryOptions, true, 'Country')
            div.col-md-3
                +floating-input('City', 'city', 'text', true, 'City', '', '', {maxlength: '50'})
        div.row
            div.col-md-6#visitName
                +floating-input('Name of the visit', 'visit_name', 'text', false, 'Visit Name (Max 100 characters)', '', '', {maxlength: '100', onchange: 'updateObjectives()'})
            div.col-md-6#eventField
                - var eventOptions = events.map(e => ({value: e.name, label: e.name}))
                +floating-select('Name of the event', 'event_name', eventOptions, false, 'Select event', '', '', {onchange: "handleOtherSelection(this, 'OtherEvent')"})
            div.col-md-3#OtherEvent(style="display: none;")
                +floating-input('Other name of the event', 'event_name_other', 'text', false, 'Specify the event name', '', '', {maxlength: '100'})
            div.col-md-6
                +floating-select('Objective of the event', 'objective', [], true, 'Objective', '', '', {onchange: "handleOtherSelection(this, 'OtherObjetive')"})
            div.col-md-3#OtherObjetive(style="display: none;")
                +floating-input('Other objectives', 'objective_other', 'text', false, 'Specify the objective', '', '', {maxlength: '100'})
            div.col-md-3
                +floating-date('Start Date', 'start_date', false, 'DD/MM/YYYY', '', '', {onchange: 'datemins(this);'})
            div.col-md-3
                +floating-date('End Date', 'end_date', false, 'DD/MM/YYYY', '', '', {onchange: 'datemins(this);'})
            div.col-md-3#eventField1
                +floating-input('Estimated Budget ($)', 'estimated_budget', 'number', true, 'Example: 1000', '', '', {min: '0', max: '999999', maxlength: '7', oninput: "if(this.value.length > 7) this.value = this.value.slice(0, 7);"})
            div.col-md-3#eventField2
                +floating-input('Number of Participants', 'participants_number', 'number', true, 'Example: 2', '', '', {min: '0', max: '999', maxlength: '3', oninput: "if(this.value.length > 3) this.value = this.value.slice(0, 3);"})
        div.row
          div.col-md-12
              +floating-textarea('Comments', 'comments', false, 'Additional comments (Max 500 characters)', '', '', {maxlength: '500'}, 5)
          div.col-md-6
              - var userOptions = users.map(u => ({value: u.UserID, label: u.Name, department: u.departamento}))
              +floating-users('Participants of the Event', 'participants', userOptions, [], false, 'Select participants', '', '', {}, true, userProfile.cdepartamento)
        div#MeetingContainer.meeting-planner-section
          div.meeting-planner-header
            span.meeting-planner-icon
              i.fas.fa-calendar-check
            span.meeting-planner-title Meetings
            span#meetingCount.meeting-badge 0
          div#meetingCardsList.meeting-cards-list
          div.meeting-add-panel
            div.row.g-2
              div.col-md-4
                div.floating-input-container
                  div.floating-input-wrapper
                    textarea#meeting_name.floating-textarea(name="meeting_name" rows="2" maxlength="100" placeholder="What is this meeting about?" data-required="false")
                    label.floating-label(for="meeting_name") Meeting Information
              div.col-md-4
                div.floating-input-container
                  div.floating-input-wrapper
                    textarea#meeting_address.floating-textarea(name="meeting_address" rows="2" maxlength="250" placeholder="Where will it take place?" data-required="false")
                    label.floating-label(for="meeting_address") Meeting Address
              div.col-md-4
                div.floating-input-container
                  div.floating-input-wrapper
                    textarea#meeting_comments.floating-textarea(name="meeting_comments" rows="2" maxlength="500" placeholder="Any additional notes..." data-required="false")
                    label.floating-label(for="meeting_comments") Comments
            button.btn.meeting-add-btn(type="button" onclick="addMeetingInformationToTable()")
              i.fas.fa-plus
              |  Add Meeting
        div.row
              div.col-md-6
                +floating-file('Supporting Documents', 'files', false, true, false, '*')
        div.row
            div.col-md-8
                    div.form-check
                        input#requisitionHrCheck.form-check-input(type="checkbox", name="performanceHrCheck" required)
                        label.form-check-label Are you sure you want to submit this form?
        div.row
            div.col-md-2
                  button#launchToastAndSubmit.form-control(style="background-color: #00586f;color: #e9ecef;") Submit

  style.
      h1, h2, h3 {
      color: rgb(0,88,111);
      }
      div.row.results{
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #e9ecef;
        padding: 15px;
        border-radius: 20px;
        margin-top: 20px;
        margin-bottom: 20px;
      }

      .form-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
      }

      .section {
      margin: 20px;
      border: 2px solid rgb(0,88,111);
      padding: 15px;
      border-radius: 20px;
      }
      
      .form-group {
        margin: 15px;
      }
      .section-flex {
        margin: 20px;
        border: 2px solid rgb(0,88,111);
        padding: 15px;
        border-radius: 20px;
        display:"flex";
        flex-wrap: "wrap";
        margin-bottom: 15px;
      }
      label:not(.floating-label):not(.floating-file-label):not(.form-check-label) {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        font-size: 1rem;
        color: black;
      }
      input[type="text"]:not(.floating-input), input[type="number"]:not(.floating-input), textarea:not(.floating-textarea) {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
      }
      input[type="text"]:not(.floating-input), select:not(.floating-select) {
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
        width: 100%;
      }
      .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .checkbox-group label {
        display: flex;
        align-items: center;
        font-weight: normal;
      }
      .checkbox-group input[type="checkbox"] {
        margin-right: 5px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
      th {
        background-color: #f2f2f2;
      }
      span:not(.error-message):not(.chip):not(.placeholder):not(.floating-label) {
        font-size: .8rem;
      }

      /* ── Meeting Planner ── */
      .meeting-planner-section {
        margin: 16px 0;
        border: 1.5px solid #d9edf2;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 1px 6px rgba(0,88,111,0.07);
      }
      .meeting-planner-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 20px;
        border-bottom: 1.5px solid #d9edf2;
      }
      .meeting-planner-icon { color: #00586f; font-size: 1.05rem; }
      .meeting-planner-title {
        font-weight: 700;
        font-size: 0.97rem;
        color: #00586f;
        letter-spacing: 0.01em;
      }
      .meeting-badge {
        background: #00586f;
        color: #fff;
        border-radius: 20px;
        padding: 1px 11px;
        font-size: 0.76rem;
        font-weight: 700;
        min-width: 26px;
        text-align: center;
      }
      .meeting-cards-list { display: flex; flex-direction: column; gap: 0; }
      .meeting-card {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 20px;
        border-bottom: 1px solid #f0f0f0;
        background: #fff;
        transition: background 0.15s;
      }
      .meeting-card:hover { background: #f5fbfd; }
      .meeting-card-accent {
        width: 4px;
        min-height: 52px;
        border-radius: 4px;
        flex-shrink: 0;
        align-self: stretch;
      }
      .meeting-card-body {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 14px;
      }
      .meeting-card-field label {
        font-size: 0.69rem;
        color: #999;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 3px;
        display: block;
      }
      .meeting-card-field textarea {
        width: 100%;
        border: none;
        border-bottom: 1px solid transparent;
        background: transparent;
        resize: none;
        font-size: 0.9rem;
        color: #222;
        outline: none;
        padding: 0;
        min-height: 36px;
        transition: border-color 0.15s, background 0.15s;
        line-height: 1.45;
      }
      .meeting-card-field textarea:focus {
        border-bottom-color: #00586f;
        background: #f0fafd;
        border-radius: 3px;
        padding: 2px 5px;
      }
      .meeting-card-remove {
        background: none;
        border: none;
        color: #ccc;
        cursor: pointer;
        padding: 5px;
        border-radius: 6px;
        flex-shrink: 0;
        transition: color 0.15s, background 0.15s;
        margin-top: 2px;
      }
      .meeting-card-remove:hover { color: #dc3545; background: #fff0f0; }
      .meeting-add-panel {
        padding: 16px 20px 14px 20px;
        border-top: 1px dashed #b0d8e0;
      }
      .meeting-add-btn {
        margin-top: 12px;
        background: #00586f;
        color: #fff;
        border-radius: 8px;
        font-size: 0.86rem;
        padding: 7px 22px;
        font-weight: 600;
        border: none;
        transition: background 0.15s, transform 0.1s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
      }
      .meeting-add-btn:hover { background: #004256; color: #fff; transform: translateY(-1px); }
      .meeting-add-btn:active { transform: translateY(0); }

      @media (max-width: 600px) {
        .checkbox-group { flex-direction: column; }
        .meeting-card-body { grid-template-columns: 1fr; }
      }

      [data-theme="dark"] h1, [data-theme="dark"] h2, [data-theme="dark"] h3 {
        color: #9ecdd9;
      }
      [data-theme="dark"] label:not(.floating-label):not(.floating-file-label):not(.form-check-label) {
        color: var(--text-primary);
      }
      [data-theme="dark"] input[type="text"]:not(.floating-input),
      [data-theme="dark"] input[type="number"]:not(.floating-input),
      [data-theme="dark"] textarea:not(.floating-textarea),
      [data-theme="dark"] select:not(.floating-select) {
        background: var(--surface-2);
        border-color: var(--border-default);
        color: var(--text-primary);
      }
      [data-theme="dark"] .section-flex {
        background: var(--surface-2);
        border-color: var(--border-default);
      }
      [data-theme="dark"] .meeting-planner-section,
      [data-theme="dark"] .meeting-card,
      [data-theme="dark"] .meeting-add-panel {
        background: var(--surface-1);
        border-color: var(--border-default);
      }
      [data-theme="dark"] .meeting-planner-header {
        background: var(--surface-2);
        border-color: var(--border-default);
      }
      [data-theme="dark"] .meeting-planner-title,
      [data-theme="dark"] .meeting-planner-icon {
        color: #9ecdd9;
      }
      [data-theme="dark"] .meeting-card-field label {
        color: var(--text-muted);
      }
      [data-theme="dark"] .meeting-card-field textarea {
        color: var(--text-primary);
      }
      [data-theme="dark"] .meeting-card-field textarea:focus {
        background: var(--surface-2);
        border-color: #9ecdd9;
      }
      [data-theme="dark"] .meeting-card:hover {
        background: var(--surface-2);
      }
      [data-theme="dark"] .meeting-badge {
        background: #255868;
      }
      [data-theme="dark"] .meeting-add-btn {
        background: #255868;
        color: #e8f4f7;
      }
      [data-theme="dark"] .meeting-add-btn:hover {
        background: #2f6170;
      }
      [data-theme="dark"] .meeting-card-remove:hover {
        background: #4c2d34;
        color: #f3d0d4;
      }
   
  script.
    function getParticipantsFromUI() {
      const participantsDisplay = document.querySelector('.floating-users-display[data-name="participants"]');
      if (!participantsDisplay) return [];
      const hiddenInputs = participantsDisplay.querySelectorAll('input[type="hidden"]');
      const options = JSON.parse(participantsDisplay.getAttribute('data-options'));
      return Array.from(hiddenInputs).map(input => {
        const opt = options.find(o => o.value == input.value);
        return { name: opt ? opt.label : input.value };
      });
    }
    // Clear error state when user fills a field
    document.addEventListener('DOMContentLoaded', function() {
      ['category','country','city','objective','estimated_budget','participants_number','event_name','visit_name','event_name_other','objective_other'].forEach(function(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('change', function() { if (this.value) this.classList.remove('error'); });
        el.addEventListener('input',  function() { if (this.value) this.classList.remove('error'); });
      });
    });
    let meetingsArray = [];
    $("#launchToastAndSubmit").click(async function(e) {
      e.preventDefault();
      let meetings = meetingsArray;
      const user_name = document.getElementById('collaborator_name').value;
      const status = document.getElementById('estado').value;
      const department = document.getElementById('id_dep_inicio').value;
      const approval_name = document.getElementById('approvals_select').value;
      const verificador = document.getElementById('verificador').value;
      const aprobador = document.getElementById('aprobador').value;
      const firmante = document.getElementById('firmante').value;
      const ejecutor = document.getElementById('ejecutor').value;
      const operador = document.getElementById('operador').value;
      const cusuario = document.getElementById('username').value;

      const category = document.getElementById('category').value;
      const country = document.getElementById('country').value.trim();
      const city = document.getElementById('city').value;
      const event_name = document.getElementById('event_name').value;
      const objective = document.getElementById('objective').value;
      const estimatedBudget = document.getElementById('estimated_budget').value;
      const participants_number = document.getElementById('participants_number').value;
      const comments = document.getElementById('comments').value;
      const startDate = document.getElementById('start_date').value;
      const endDate = document.getElementById('end_date').value;
      const url = new URL(window.location.href);
      const params = new URLSearchParams(url.search);
      const iddevteam = params.get('iddevteam');
      const event_name_other = document.getElementById('event_name_other');
      const objective_other = document.getElementById('objective_other');

      // ---- VALIDATION ----
      function markError(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('valid', 'has-value');
        el.classList.add('error');
      }

      function checkField(id) {
        const el = document.getElementById(id);
        if (!el) return true;
        if (el.value && el.value.trim()) return true;
        markError(id);
        return false;
      }

      let isValid = true;

      if (!checkField('category'))           isValid = false;
      if (!checkField('country'))            isValid = false;
      if (!checkField('city'))               isValid = false;
      if (!checkField('objective'))          isValid = false;
      if (!checkField('estimated_budget'))   isValid = false;
      if (!checkField('participants_number')) isValid = false;

      if (category === 'Event Conference') {
        if (!checkField('event_name')) isValid = false;
        if (event_name === 'Other' && (!event_name_other || !event_name_other.value.trim())) {
          markError('event_name_other');
          isValid = false;
        }
      } else if (category === 'Market Visit') {
        if (!checkField('visit_name')) isValid = false;
      }

      if (objective === 'Other' && (!objective_other || !objective_other.value.trim())) {
        markError('objective_other');
        isValid = false;
      }

      if (!isValid) {
        launch_toast("Error, required fields are empty", 2);
        return;
      }
      // ---- END VALIDATION ----

      const formData = new FormData();
      formData.append('status', status);
      formData.append('department', department);
      formData.append('approval_name', approval_name);
      formData.append('solicitante', user_name);
      formData.append('cusuario', cusuario);
      formData.append('verificador', verificador);
      formData.append('aprobador', aprobador);
      formData.append('firmante', firmante);
      formData.append('ejecutor', ejecutor);
      formData.append('operador', operador);
      formData.append('category', category);
      formData.append('country', country);
      formData.append('city', city);
      formData.append('objective', objective === 'Other' ? objective_other.value : objective);
      formData.append('event_name', event_name === 'Other' ? event_name_other.value : event_name);
      formData.append('estimated_budget', estimatedBudget);
      formData.append('participants_number', participants_number);
      formData.append('comments', comments);
      formData.append('start_date', startDate);
      formData.append('end_date', endDate);
      formData.append('participants', JSON.stringify(getParticipantsFromUI()));
      formData.append('meetings', JSON.stringify(meetingsArray));
      const uploadedFiles = window['getFiles_files'] ? window['getFiles_files']() : [];
      uploadedFiles.forEach((file) => {
        formData.append('files', file);
      });

      try {
        const response = await fetch('forms_marketing_events', {
          method: 'POST',
          body: formData,
        });
        const data = await response.json();
        if (!response.ok) {
          launch_toast(data.error || "Error creating the event", 2);
          return;
        }
        let redirectRute = `/approvals-detalle?RowID=${data.id}`;
        window.location.href = redirectRute;
        launch_toast("Successfully Created", 1);
      } catch (error) {
        console.log(error);
        launch_toast("Error creating the event", 2);
      }
    });
    function removeFromTable(button, type) {
      if (type === 'meetings') {
        const card = button.closest('.meeting-card');
        const index = parseInt(card.dataset.index);
        meetingsArray.splice(index, 1);
        card.remove();
        document.querySelectorAll('#meetingCardsList .meeting-card').forEach(function(c, i) {
          c.dataset.index = i;
          c.querySelectorAll('textarea[data-index]').forEach(function(ta) { ta.dataset.index = i; });
        });
        updateMeetingCount();
      }
    }
    function addMeetingInformationToTable() {
      const meetingName = document.getElementById('meeting_name').value.trim();
      const meetingAddress = document.getElementById('meeting_address').value.trim();
      const meetingComments = document.getElementById('meeting_comments').value.trim();

      if (!meetingName && !meetingAddress && !meetingComments) return;

      const meetingExists = meetingsArray.some(meeting => meeting.meeting_name === meetingName);
      if (meetingExists) {
        launch_toast("Meeting name already exists", 2);
        return;
      }

      const index = meetingsArray.length;
      meetingsArray.push({ meeting_name: meetingName, meeting_address: meetingAddress, meeting_comments: meetingComments });

      const card = document.createElement('div');
      card.className = 'meeting-card';
      card.dataset.index = index;
      card.innerHTML = `
        <div class="meeting-card-accent"></div>
        <div class="meeting-card-body">
