          '.pcp-btn:disabled{opacity:.65;cursor:default;}' +
          '.pcp-flag{font-size:.92rem;line-height:1;}' +
          '.pcp-dial{font-size:.75rem;color:#555;letter-spacing:.01em;}' +
          '.pcp-divider{width:1px;height:16px;background:#ddd;flex-shrink:0;margin:0 3px;}' +
          '.pcp-number{flex:1;min-width:60px;border:none;border-bottom:1px solid transparent;background:transparent;font-size:.82rem;padding:4px 5px;outline:none;border-radius:3px;transition:border-color .15s,background .15s;}' +
          '.pcp-number:focus{border-bottom-color:#00586f;background:#f0fafd;}' +
          '.pcp-number[readonly]{cursor:default;color:#555;}' +
          '.pcp-dropdown{position:fixed;z-index:9999;background:#fff;border:1px solid #d0dce0;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,.13);min-width:260px;max-height:280px;overflow-x:hidden;overflow-y:auto;padding-bottom:4px;}' +
          '.pcp-search-header{position:sticky;top:0;background:#fff;padding:7px 8px 5px;border-bottom:1px solid #f0f0f0;z-index:1;}' +
          '.pcp-search{width:100%;padding:5px 9px;border:1px solid #ddd;border-radius:5px;font-size:.8rem;outline:none;box-sizing:border-box;}' +
          '.pcp-options{list-style:none;padding:0;margin:0;}' +
          '.pcp-option{display:flex;align-items:center;gap:6px;padding:6px 10px;cursor:pointer;font-size:.82rem;transition:background .1s;}' +
          '.pcp-option:hover,.pcp-option:focus{background:#f0fafd;color:#00586f;outline:none;}' +
          '.pcp-option-flag{font-size:.92rem;flex-shrink:0;}' +
          '.pcp-option-name{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
          '.pcp-option-dial{color:#999;font-size:.74rem;white-space:nowrap;}';
        document.head.appendChild(_s);
      }

      // ── Countries data once (serialized server-side) ─────────────────────
      if (!window.phoneCountriesData) {
        window.phoneCountriesData = !{JSON.stringify(_pcpCountries)};
      }

      // ── Register behavior once ───────────────────────────────────────────
      if (window._pcpReady) return;
      window._pcpReady = true;

