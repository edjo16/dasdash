      window.pcpBuildCell = function (val) {
        var data = window.phoneCountriesData || [];
        var matched = null;
        if (val) {
          data.forEach(function (c) {
            if (val.startsWith(c.dialCode)) {
              if (!matched || c.dialCode.length > matched.dialCode.length) matched = c;
            }
          });
        }
        var flag     = matched ? matched.flag     : '🇵🇦';
        var dial     = matched ? matched.dialCode : '+507';
        var number   = matched ? val.substring(matched.dialCode.length).trim() : (val || '');
        var options  = data.map(function (c) {
          return '<li class="pcp-option" data-code="' + c.code + '" data-dialcode="' + c.dialCode + '" tabindex="-1">' +
                   '<span class="pcp-option-flag">' + c.flag + '</span>' +
                   '<span class="pcp-option-name">' + c.name + '</span>' +
                   '<span class="pcp-option-dial">(' + c.dialCode + ')</span>' +
                 '</li>';
        }).join('');
        return '<td><div class="phone-cell-picker">' +
          '<button class="pcp-btn" type="button">' +
            '<span class="pcp-flag">' + flag + '</span>' +
            '<span class="pcp-dial">' + dial + '</span>' +
            '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">' +
              '<polyline points="6 9 12 15 18 9"></polyline></svg>' +
          '</button>' +
          '<div class="pcp-divider"></div>' +
          '<input class="pcp-number action-input" type="tel" value="' + number.replace(/"/g, '&quot;') + '" placeholder="XXXX-XXXX">' +
          '<input type="hidden" data-field="phone" value="' + (val || '').replace(/"/g, '&quot;') + '">' +
          '<div class="pcp-dropdown" hidden>' +
            '<div class="pcp-search-header"><input class="pcp-search" type="text" placeholder="Search country or code..."></div>' +
            '<ul class="pcp-options">' + options + '</ul>' +
          '</div>' +
        '</div></td>';
      };

      window.pcpInit = function () {
        document.querySelectorAll('.phone-cell-picker:not([data-pcp])').forEach(function (picker) {
          picker.setAttribute('data-pcp', '1');

          var btn      = picker.querySelector('.pcp-btn');
          var flagEl   = picker.querySelector('.pcp-flag');
          var dialEl   = picker.querySelector('.pcp-dial');
          var numInput = picker.querySelector('.pcp-number');
          var hidden   = picker.querySelector('input[data-field]');
          var dropdown = picker.querySelector('.pcp-dropdown');
          var search   = picker.querySelector('.pcp-search');

          if (!btn || !numInput || !hidden || !dropdown) return;

          var currentDial = dialEl ? dialEl.textContent : '+507';

          function updateHidden() {
            var num = numInput.value.trim();
            hidden.value = num ? (currentDial + ' ' + num) : '';
          }

          function openDropdown() {
            var rect = btn.getBoundingClientRect();
            dropdown.style.top   = (rect.bottom + 2) + 'px';
            dropdown.style.left  = rect.left + 'px';
            dropdown.style.width = Math.max(rect.width + 40, 260) + 'px';
            dropdown.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
            if (search) { search.value = ''; filterOptions(''); search.focus(); }
          }

          function closeDropdown() {
            dropdown.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
          }

          function filterOptions(q) {
            dropdown.querySelectorAll('.pcp-option').forEach(function (opt) {
              var name = opt.querySelector('.pcp-option-name').textContent.toLowerCase();
              var dial = opt.dataset.dialcode.toLowerCase();
              var code = opt.dataset.code.toLowerCase();
              opt.style.display = (!q || name.includes(q) || dial.includes(q) || code.includes(q)) ? '' : 'none';
            });
          }

          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            dropdown.hidden ? openDropdown() : closeDropdown();
          });

          if (search) {
            search.addEventListener('input', function () { filterOptions(this.value.toLowerCase()); });
            search.addEventListener('keydown', function (e) {
              if (e.key === 'ArrowDown') {
                e.preventDefault();
                var first = dropdown.querySelector('.pcp-option:not([style*="display: none"])');
                if (first) first.focus();
              } else if (e.key === 'Escape') {
                closeDropdown(); btn.focus();
              }
            });
          }

          dropdown.querySelectorAll('.pcp-option').forEach(function (opt) {
            opt.addEventListener('click', function () {
              currentDial = this.dataset.dialcode;
              if (flagEl) flagEl.textContent = this.querySelector('.pcp-option-flag').textContent;
              if (dialEl) dialEl.textContent = currentDial;
              updateHidden();
              closeDropdown();
              numInput.focus();
            });
            opt.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault(); this.click();
              } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                var next = this.nextElementSibling;
                while (next && next.style.display === 'none') next = next.nextElementSibling;
                if (next) next.focus();
              } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                var prev = this.previousElementSibling;
                while (prev && prev.style.display === 'none') prev = prev.previousElementSibling;
                if (prev) prev.focus(); else if (search) search.focus();
              } else if (e.key === 'Escape') {
                closeDropdown(); btn.focus();
              }
            });
          });

          numInput.addEventListener('keydown', function (e) {
            if (e.key === ';') e.preventDefault();
          });

          numInput.addEventListener('input', function () {
            this.value = this.value.replace(/[^\d\s\-\(\)\.]/g, '');
            updateHidden();
          });
        });
      };

      // Close dropdown when clicking outside
      document.addEventListener('click', function (e) {
        var open = document.querySelector('.pcp-dropdown:not([hidden])');
        if (!open) return;
        if (!open.closest('.phone-cell-picker').contains(e.target)) open.hidden = true;
      });

      // Close dropdown on page scroll — but not when scrolling the dropdown itself
      window.addEventListener('scroll', function (e) {
        var open = document.querySelector('.pcp-dropdown:not([hidden])');
        if (!open) return;
        if (open.contains(e.target)) return;
        open.hidden = true;
      }, true);

      document.addEventListener('DOMContentLoaded', window.pcpInit);
    }());
