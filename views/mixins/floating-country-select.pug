  div.floating-select-container(class=containerClass)
    div.floating-select-wrapper
      select(
        id=`${nameLocation}_picker`
        class='floating-select'
        data-required=required
      )
        option(value='' selected disabled)= 'Select a country'
        each c in countryList
          option(value=c.code data-name=c.name)= `${c.name} (${c.code})`

      label.floating-label(for=`${nameLocation}_picker`)= label + (required ? ' *' : '')

      include ./validation-icons.pug
      +successIcon()
      +errorIcon()

    span.error-message(data-error-for=`${nameLocation}_picker`)

    div.d-flex.flex-wrap.gap-1.mt-2(id=`${nameLocation}_chips`)

    input(type='hidden' name=nameLocation id=nameLocation)
    input(type='hidden' name=nameLocation1 id=nameLocation1)

  script.
    (function() {
      var locId     = '#{nameLocation}';
      var loc1Id    = '#{nameLocation1}';
      var initCodes = '#{initialCodes}';

      document.addEventListener('DOMContentLoaded', function() {
        var picker    = document.getElementById(locId + '_picker');
        var chipsEl   = document.getElementById(locId + '_chips');
        var locInput  = document.getElementById(locId);
        var loc1Input = document.getElementById(loc1Id);
        var errorMsg  = document.querySelector('[data-error-for="' + locId + '_picker"]');

        if (!picker || !chipsEl || !locInput || !loc1Input) return;

        var selected = [];

        function updateInputs() {
          locInput.value  = selected.map(function(s) { return s.name; }).join(',');
          loc1Input.value = selected.map(function(s) { return s.code; }).join(',');
        }

        function updateSelectState() {
          picker.classList.remove('valid', 'error', 'has-value');
          if (selected.length > 0) {
            picker.classList.add('has-value', 'valid');
            if (errorMsg) errorMsg.classList.remove('show');
          } else if (picker.dataset.required === 'true' && picker.dataset.touched === 'true') {
            picker.classList.add('error');
            if (errorMsg) {
              errorMsg.textContent = '#{label} is required';
              errorMsg.classList.add('show');
            }
          }
        }

        function renderChips() {
          chipsEl.innerHTML = '';
          selected.forEach(function(s) {
            var chip = document.createElement('span');
            chip.className = 'badge bg-primary d-inline-flex align-items-center gap-1 me-1 mb-1';
            chip.style.fontSize = '0.8rem';
            var text = document.createTextNode(s.name + ' (' + s.code + ')');
            var closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'btn-close btn-close-white';
            closeBtn.style.cssText = 'font-size:0.6rem;width:0.75em;height:0.75em;margin-left:4px;';
            closeBtn.setAttribute('aria-label', 'Remove ' + s.name);
            closeBtn.addEventListener('click', function() {
              selected = selected.filter(function(x) { return x.code !== s.code; });
              renderChips();
              updateInputs();
              updateSelectState();
            });
            chip.appendChild(text);
            chip.appendChild(closeBtn);
            chipsEl.appendChild(chip);
          });
        }

        // Auto-add on selection change
        picker.addEventListener('change', function() {
          var code = picker.value;
          if (!code) return;
          var opt  = picker.options[picker.selectedIndex];
          var name = opt ? opt.getAttribute('data-name') : code;
          if (!name) return;
          if (!selected.find(function(s) { return s.code === code; })) {
            selected.push({ code: code, name: name });
            renderChips();
            updateInputs();
          }
          picker.value = '';
          picker.dataset.touched = 'true';
          updateSelectState();
        });

        picker.addEventListener('blur', function() {
          picker.dataset.touched = 'true';
          updateSelectState();
        });

        // Expose global validation helpers (same API as floating-select)
        window['validateSelect_' + locId + '_picker'] = function() {
          picker.dataset.touched = 'true';
          updateSelectState();
          return selected.length > 0 || picker.dataset.required !== 'true';
        };

        window['setSelectError_' + locId + '_picker'] = function(message) {
          picker.classList.remove('valid');
          picker.classList.add('error');
          if (errorMsg) {
            errorMsg.textContent = message || '#{label} is required';
            errorMsg.classList.add('show');
          }
          return false;
        };

        window['clearSelectError_' + locId + '_picker'] = function() {
          picker.classList.remove('error');
          if (errorMsg) errorMsg.classList.remove('show');
          if (selected.length > 0) picker.classList.add('valid');
        };

        // Initialize from existing codes (edit mode)
        if (initCodes && initCodes.trim()) {
          initCodes.split(',').map(function(c) { return c.trim(); }).filter(Boolean).forEach(function(code) {
            var opt = picker.querySelector('option[value="' + code + '"]');
            if (opt && !selected.find(function(s) { return s.code === code; })) {
              selected.push({ code: code, name: opt.getAttribute('data-name') || code });
            }
          });
          if (selected.length) {
            renderChips();
            updateInputs();
            updateSelectState();
          }
        }
      });
    })();
