//- ── Contact Modal (create + view/edit) ──────────────────────────────────
//- Public API:
//-   window.openNewContactModal(prefill?)  -> create mode, optionally pre-filled with
//-                                            { name, email, phone, job_title, address,
//-                                              bmc_id, bmjl_id, country, event, company }
//-                                            Foreign keys (bmc_id / bmjl_id / country /
//-                                            event) win when provided; `company` is the
//-                                            fallback and is matched by name against the
//-                                            Company options, case-insensitive.
//-   window.openContactModal(contact_id)   -> edit mode (fetches the contact)
//- On a successful save it calls window._badacoContactRefresh() if defined.

- var ctmCompanyOptions = (typeof companies !== 'undefined' ? companies : []).map(function(c) { return { value: c.bmc_id, label: c.nombre + (c.xnombre_pais_ingles ? ' (' + c.xnombre_pais_ingles + ')' : '') }; })
- var ctmJobLevelOptions = (typeof jobLevels !== 'undefined' ? jobLevels : []).map(function(jl) { return { value: jl.bmjl_id, label: jl.name }; })
- var ctmCountryOptions = (typeof allCountries !== 'undefined' ? allCountries : []).map(function(c) { return { value: c.cpais, label: (c.xnombre_pais_ingles || '').trim() }; })
- var ctmRelationshipOptions = (typeof relationships !== 'undefined' ? relationships : []).map(function(r) { return { value: r.bmrl_id, label: r.name }; })
- var ctmEventOptions = (typeof events !== 'undefined' ? events : []).map(function(e) { return { value: e.id, label: (e.event_name ? e.event_name : e.visit_name) + ' - ' + e.category }; })
- var ctmUserOptions = (typeof grupousuarios_active !== 'undefined' ? grupousuarios_active : []).map(function(u) { return { value: u.UserID, label: u.Name, department: u.departamento }; })

