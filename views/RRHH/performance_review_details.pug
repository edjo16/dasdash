extends ../layout
block layout-content
  div#layoutSidenav_content(style="justify-content: start;")
    main
      div.container-fluid.px-4
        a(href=`/approvals-detalle?RowID=${details.log_id}` style="color:#212529")
            i.fas.fa-chevron-left
            span(href=`/approvals-detalle?RowID=${details.log_id}` style="padding-left: 0.5rem;") Back
        h1.mt-4 #{title}
        ol.breadcrumb.mb-4
          li.breadcrumb-item.active This form is designed to create an evaluation of the performance of the colaborator in the organization.
    form#performance_review_details(method="put" action=`/forms_hr_performance_review/${details.id}` enctype="multipart/form-data")
      .section-flex
        h3 General Information
        div.row.Not
                div.col-md-4
                    label id
                    p#performance_review_details_id.form-control #{details.id}
                div.col-md-3
                  label(for="userUpdated") userUpdated:
                  p #{userProfile.UsuarioID}
        div.row
            div.col-md-3
                label(for="collaboratorName") Collaborator's name:
                p #{details.collaboratorName}
            div.col-md-3
                label(for="collabjobTitle") Collaborator's job Tittle:
                p #{details.collabjobTitle}
            div.col-md-3
                label(for="leaderName") Name of direct leader:
                p #{details.leaderName}
            div.col-md-3
                label(for="leaderJobTitle") leader's job Tittle :
                p #{details.leaderJobTitle}
        div.row.results
            div.col-md-3
                label(for="averageGoal") Average Goal Achieved:
                if read == "true"
                    input#averageGoal(type="range", name="averageGoal", min="0", max="100", value=details.averageGoal, oninput="rangeOutput.value = averageGoal.value + ' %'", disabled)
                    output(for="averageGoal" id="rangeOutput") #{details.averageGoal} %
                else
                    input#averageGoal(type="range", name="averageGoal", min="0", max="100", value=details.averageGoal, oninput="rangeOutput.value = averageGoal.value + ' %'")
                    output(for="averageGoal" id="rangeOutput") #{details.averageGoal} %
            div.col-md-3
                label(for="developmentGoal") Development goal Achived:
                if read == "true"
                    input#developmentGoal(type="range", name="developmentGoal" min="0" max="100", value=details.developmentGoal oninput="devRangeOutput.value = developmentGoal.value + ' %'" disabled)
                    output(for="developmentGoal" id="devRangeOutput") #{details.developmentGoal} %
                else
                    input#developmentGoal(type="range", name="developmentGoal" min="0" max="100", value=details.developmentGoal oninput="devRangeOutput.value = developmentGoal.value + ' %'" )
                    output(for="developmentGoal" id="devRangeOutput") #{details.developmentGoal} %
            div.col-md-6
                label(for="generalResult") General Result:
                if read == "true"
                  select#generalResult(name="generalResult", disabled)
                    option(value=details.generalResult, selected=details.generalResult === 'rarely') #{details.generalResult}
                else
                  select#generalResult(name="generalResult")
                    option(value="Rarely Achieves", selected=details.generalResult === 'Rarely Achieves') Rarely Achieves
                    option(value="Sometimes Achieves", selected=details.generalResult === 'Sometimes Achieves') Sometimes Achieves
                    option(value="Fully Achieves", selected=details.generalResult === 'Fully Achieves') Fully Achieves
                    option(value="Sometimes Exceeds", selected=details.generalResult === 'Sometimes Exceeds') Sometimes Exceeds
                    option(value="Consistently Exceeds", selected=details.generalResult === 'Consistently Exceeds') Consistently Exceeds
        div.row
            div.col-md-12
                label(for="observationsLeader") General Observation leader:
                if read == "true"
                    textarea#observationsLeader(name="observationsLeader", rows="3" readonly) #{details.observationsLeader}
                else 
                    textarea#observationsLeader(name="observationsLeader", rows="3") #{details.observationsLeader}
            div.col-md-12
                label(for="observationsAssociate" ) General observations associate:
                if read === "true"
                    textarea#observationsAssociate(name="observationsAssociate", rows="3" readonly ) #{details.observationsAssociate}
                else
                    textarea#observationsAssociate(name="observationsAssociate", rows="3" ) #{details.observationsAssociate}

        div.row
            div.col-md-2
                if read !== "true"
                  button#updatePerformanceRequest.form-control(style="background-color: #00586f;color: #e9ecef;") Update
