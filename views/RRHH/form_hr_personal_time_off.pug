    function switchLang(lang) {
      currentLang = lang;
      document.getElementById('btn-lang-en').classList.toggle('active', lang === 'en');
      document.getElementById('btn-lang-es').classList.toggle('active', lang === 'es');

      // Update all elements with data-i18n
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (i18n[lang][key]) {
          el.textContent = i18n[lang][key];
        }
      });

      // Update floating labels
      updateFloatingLabels(lang);
    }

    function updateFloatingLabels(lang) {
      var labelMap = {
        start_permit_hour: lang === 'es' ? 'Hora de Inicio' : 'Start Hour',
        end_permit_hour: lang === 'es' ? 'Hora de Fin' : 'End Hour',
        start_date: lang === 'es' ? 'Fecha de Inicio *' : 'Start Date *',
        end_date: lang === 'es' ? 'Fecha de Fin *' : 'End Date *',
        notes: lang === 'es' ? 'Notas / Anotaciones' : 'Notes / Annotations',
        Supportfiles: lang === 'es' ? 'Documento de Soporte PDF' : 'PDF Support Document'
      };
      Object.keys(labelMap).forEach(function(fieldName) {
        var lbl = document.querySelector('.floating-label[for="' + fieldName + '"]');
        if (lbl) lbl.textContent = labelMap[fieldName];
        var fileLbl = document.querySelector('.floating-file-label[for="' + fieldName + '"]');
        if (fileLbl) fileLbl.textContent = labelMap[fieldName];
      });
    }

    // ============================================================
    // Stepper Logic
    // ============================================================
    var currentStep = 1;
    var totalSteps = 4;

    function updateStepper() {
      document.querySelectorAll('.pto-step-indicator').forEach(function(ind) {
        var s = parseInt(ind.getAttribute('data-step'));
        ind.classList.remove('active', 'completed');
        if (s === currentStep) ind.classList.add('active');
        else if (s < currentStep) ind.classList.add('completed');
      });
      document.querySelectorAll('.pto-step-content').forEach(function(panel) {
        var s = parseInt(panel.getAttribute('data-step'));
        panel.classList.toggle('active', s === currentStep);
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function ptoNext() {
      if (!validateCurrentStep()) return;
      if (currentStep < totalSteps) {
        if (currentStep === 3) populateReview();
        currentStep++;
        updateStepper();
      }
    }

    function ptoPrev() {
      if (currentStep > 1) {
        currentStep--;
        updateStepper();
      }
    }

    // ============================================================
    // Type Selection
    // ============================================================
    var selectedType = null;

    function selectType(card) {
      document.querySelectorAll('.pto-type-card').forEach(function(c) { c.classList.remove('selected'); });
      card.classList.add('selected');
      selectedType = card.getAttribute('data-type');
      document.getElementById('request_type').value = selectedType;

      // Enable next button on step 2
      var nextBtn = card.closest('.pto-step-content').nextElementSibling;
      // Actually just find the step 2 next button
      var step2 = document.querySelector('.pto-step-content[data-step="2"]');
      var btn = step2.querySelector('.pto-btn-next');
      if (btn) btn.disabled = false;

      // Show/hide partial permit time fields
      var partialFields = document.getElementById('partial-permit-fields');
      var startHour = document.getElementById('start_permit_hour');
      var endHour = document.getElementById('end_permit_hour');

      if (selectedType === 'partial_permit') {
        partialFields.style.display = 'block';
        startHour.dataset.required = 'true';
        endHour.dataset.required = 'true';
      } else {
        partialFields.style.display = 'none';
        startHour.dataset.required = 'false';
        endHour.dataset.required = 'false';
        startHour.value = '';
        endHour.value = '';
      }

      // Clear file visual error when switching type away from medical_cert
      if (window['clearInputError_Supportfiles']) {
        window['clearInputError_Supportfiles']();
      }
    }

    // ============================================================
    // Validation
    // ============================================================
    function validateCurrentStep() {
      if (currentStep === 1) return true;

      if (currentStep === 2) {
        if (!selectedType) {
          launch_toast(i18n[currentLang].toast_type_required, 2);
          return false;
        }
        return true;
      }

      if (currentStep === 3) {
        var allValid = true;

        // Validate dates — use setInputError_ directly to guarantee visual feedback
        var startVal = document.getElementById('start_date').value;
        var endVal = document.getElementById('end_date').value;
        var startLabel = currentLang === 'es' ? 'Fecha de Inicio es requerido' : 'Start Date is required';
        var endLabel   = currentLang === 'es' ? 'Fecha de Fin es requerido'    : 'End Date is required';

        if (!startVal) {
          window['setInputError_start_date'] && window['setInputError_start_date'](startLabel);
          allValid = false;
        } else {
          window['clearInputError_start_date'] && window['clearInputError_start_date']();
        }

        if (!endVal) {
          window['setInputError_end_date'] && window['setInputError_end_date'](endLabel);
          allValid = false;
        } else {
          window['clearInputError_end_date'] && window['clearInputError_end_date']();
        }

        if (startVal && endVal) {
          var startParts = startVal.split('/');
          var endParts = endVal.split('/');
          var startDt = new Date(startParts[2], startParts[1] - 1, startParts[0]);
          var endDt = new Date(endParts[2], endParts[1] - 1, endParts[0]);
          var today = new Date();
          today.setHours(0,0,0,0);

          if (endDt < startDt) {
            window['setInputError_end_date'] && window['setInputError_end_date'](i18n[currentLang].toast_date_invalid);
            allValid = false;
          }
        }

        // Validate partial permit hours
        if (selectedType === 'partial_permit') {
          var fnStartHour = window['validateSelect_start_permit_hour'];
          var fnEndHour = window['validateSelect_end_permit_hour'];
          if (fnStartHour && !fnStartHour()) allValid = false;
          if (fnEndHour && !fnEndHour()) allValid = false;

          var sh = document.getElementById('start_permit_hour').value;
          var eh = document.getElementById('end_permit_hour').value;
          if (sh && eh && timeToMinutes(sh) >= timeToMinutes(eh)) {
            window['setSelectError_end_permit_hour'](i18n[currentLang].toast_hour_invalid);
            allValid = false;
          }
        }

        // Validate mandatory file for medical certificate
        if (selectedType === 'medical_cert') {
          var getFiles = window['getFiles_Supportfiles'];
          var files = getFiles ? getFiles() : [];
          if (files.length === 0) {
            if (window['setInputError_Supportfiles']) {
              window['setInputError_Supportfiles'](i18n[currentLang].toast_file_required);
            }
            allValid = false;
          } else {
            if (window['clearInputError_Supportfiles']) {
              window['clearInputError_Supportfiles']();
            }
          }
        }

        if (!allValid) {
          launch_toast(i18n[currentLang].toast_fill_fields, 2);
        }
        return allValid;
      }

      if (currentStep === 4) {
        return true;
      }

      return true;
    }

    function timeToMinutes(timeStr) {
      var match = timeStr.match(/(\d{2}):(\d{2})\s*(AM|PM)/i);
      if (!match) return 0;
      var h = parseInt(match[1]);
      var m = parseInt(match[2]);
      var period = match[3].toUpperCase();
      if (period === 'PM' && h !== 12) h += 12;
      if (period === 'AM' && h === 12) h = 0;
      return h * 60 + m;
    }

    // ============================================================
    // Review Population
    // ============================================================
    var typeLabels = {
      en: {
        vacation: 'Request Vacation / Out of office period',
        medical_cert: 'Register absence with medical certificate',
        no_medical_cert: 'Register absence without medical certificate',
        partial_permit: 'Partial permit',
        non_remunerated: 'Non-remunerated time',
        license: 'License'
      },
      es: {
        vacation: 'Solicitud de Vacaciones / Período fuera de oficina',
        medical_cert: 'Registrar ausencia con certificado médico',
        no_medical_cert: 'Registrar ausencia sin certificado médico',
        partial_permit: 'Permiso parcial',
        non_remunerated: 'Tiempo no remunerado',
        license: 'Licencia'
      }
    };

    function populateReview() {
      document.getElementById('review-type').textContent = typeLabels[currentLang][selectedType] || selectedType;
      document.getElementById('review-start').textContent = document.getElementById('start_date').value || '-';
      document.getElementById('review-end').textContent = document.getElementById('end_date').value || '-';
      document.getElementById('review-notes').textContent = document.getElementById('notes').value || '-';

      // Hours row
      var hoursRow = document.getElementById('review-hours-row');
      if (selectedType === 'partial_permit') {
        hoursRow.style.display = '';
        var sh = document.getElementById('start_permit_hour').value;
        var eh = document.getElementById('end_permit_hour').value;
        document.getElementById('review-hours').textContent = sh + ' - ' + eh;
      } else {
        hoursRow.style.display = 'none';
      }

      // Actors panel
      renderActorsPanel();

      // Files
      var getFiles = window['getFiles_Supportfiles'];
      if (getFiles) {
        var files = getFiles();
        document.getElementById('review-files').textContent = files.length > 0
          ? files.length + ' ' + i18n[currentLang].review_attached
          : i18n[currentLang].review_none;
      } else {
        document.getElementById('review-files').textContent = i18n[currentLang].review_none;
      }
    }

    // ============================================================
    // Confirm checkbox enables submit
    // ============================================================
    var _ptoActors = null;
    var _ptoFlow = null;
    var _ptoEstado = null;

    document.addEventListener('DOMContentLoaded', function() {
      var confirmCb = document.getElementById('confirmSubmit');
      var submitBtn = document.getElementById('btnSubmitPto');

      submitBtn.disabled = true;
      submitBtn.addEventListener('click', submitPTO);

      confirmCb.addEventListener('change', function() {
        submitBtn.disabled = !confirmCb.checked;
      });

      // Initialize datepickers with minDate = today
      // onSelect triggers floating-input visual state (datepicker bypasses native events)
      $("#start_date").datepicker({
        dateFormat: "dd/mm/yy",
        onSelect: function() {
          var input = document.getElementById('start_date');
          if (input) {
            input.classList.add('has-value');
            input.classList.remove('error');
            input.classList.add('valid');
            var errEl = document.querySelector('[data-error-for="start_date"]');
            if (errEl) errEl.classList.remove('show');
          }
        }
      });
      $("#end_date").datepicker({
        dateFormat: "dd/mm/yy",
        onSelect: function() {
          var input = document.getElementById('end_date');
          if (input) {
            input.classList.add('has-value');
            input.classList.remove('error');
            input.classList.add('valid');
            var errEl = document.querySelector('[data-error-for="end_date"]');
            if (errEl) errEl.classList.remove('show');
          }
        }
      });

      // Fetch actors for the PTO approval flow
      loadPtoActors();
    });

    function loadPtoActors() {
      fetch('/form_hr_personal_time_off/actors')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.result === 1) {
            _ptoActors = data.actors;
            _ptoFlow = data.flow;
            _ptoEstado = data.estado;
            renderActorsPanel();
          } else {
            console.error('Could not load PTO actors:', data.error);
          }
        })
        .catch(function(err) {
          console.error('Error loading PTO actors:', err);
        });
    }

    function renderActorsPanel() {
      var panel = document.getElementById('pto-actors-panel');
      if (!panel || !_ptoActors) return;

      var roles = [
        { key: 'verificador', label: 'Verifier', labelEs: 'Verificador' },
        { key: 'aprobador',   label: 'Approver', labelEs: 'Aprobador'  },
        { key: 'firmante',    label: 'Signer',   labelEs: 'Firmante'   },
        { key: 'operador',    label: 'Operator', labelEs: 'Operador'   },
        { key: 'ejecutor',    label: 'Executor', labelEs: 'Ejecutor'   }
      ];

      var html = '';
      roles.forEach(function(role) {
        var actor = _ptoActors[role.key];
        if (actor && actor.name && actor.name !== 'N/A') {
          var roleLabel = currentLang === 'es' ? role.labelEs : role.label;
          var photoSrc = actor.userId ? 'pic/' + actor.userId + '.png' : 'pic/default.png';
          html += '<div class="pto-actor-card">';
          html += '  <img class="pto-actor-avatar" src="' + photoSrc + '" onerror="this.onerror=null;this.src=\'pic/default.png\'" alt="' + actor.name + '">';
          html += '  <div class="pto-actor-info">';
          html += '    <span class="pto-actor-role">' + roleLabel + '</span>';
          html += '    <span class="pto-actor-name">' + actor.name + '</span>';
          html += '  </div>';
          html += '</div>';
        }
      });

      if (html === '') {
        html = '<p style="color:#999;font-size:.85rem;">No actors resolved</p>';
      }

      panel.innerHTML = html;
      panel.style.display = 'block';
    }

    // ============================================================
    // Submit
    // ============================================================
    function submitPTO() {
      if (!document.getElementById('confirmSubmit').checked) {
        launch_toast(i18n[currentLang].toast_confirm, 2);
        return;
      }

      // Final validation guard before submit
      var startVal = document.getElementById('start_date').value;
      var endVal = document.getElementById('end_date').value;
      if (!startVal || !endVal) {
        launch_toast(i18n[currentLang].toast_fill_fields, 2);
        return;
      }
      if (selectedType === 'medical_cert') {
        var getFilesFinal = window['getFiles_Supportfiles'];
        var filesFinal = getFilesFinal ? getFilesFinal() : [];
        if (filesFinal.length === 0) {
          launch_toast(i18n[currentLang].toast_file_required, 2);
          return;
        }
      }

      if (!_ptoActors || !_ptoFlow) {
        launch_toast(currentLang === 'es' ? 'Error: no se pudieron cargar los actores del flujo' : 'Error: could not load flow actors', 2);
        return;
      }

      var formData = new FormData();
      formData.append('request_type', selectedType);
      formData.append('start_date', document.getElementById('start_date').value);
      formData.append('end_date', document.getElementById('end_date').value);
      formData.append('notes', document.getElementById('notes').value);

      if (selectedType === 'partial_permit') {
        formData.append('start_permit_hour', document.getElementById('start_permit_hour').value);
        formData.append('end_permit_hour', document.getElementById('end_permit_hour').value);
      }

      // Append actor data for approval creation
      formData.append('verificador', _ptoActors.verificador?.name || 'N/A');
      formData.append('aprobador', _ptoActors.aprobador?.name || 'N/A');
      formData.append('firmante', _ptoActors.firmante?.name || 'N/A');
      formData.append('operador', _ptoActors.operador?.name || 'N/A');
      formData.append('ejecutor', _ptoActors.ejecutor?.name || 'N/A');
      formData.append('estado', _ptoEstado || 'Verify');

      // Append files
      var getFiles = window['getFiles_Supportfiles'];
      if (getFiles) {
        var files = getFiles();
        files.forEach(function(file) {
          formData.append('Supportfiles', file);
        });
      }

      // Disable button to prevent double submit
      var _btn = window['submitBtn_btnSubmitPto'];
      if (_btn) _btn.setSending(currentLang === 'es' ? 'Enviando...' : 'Submitting...');

      fetch('/form_hr_personal_time_off', {
        method: 'POST',
        body: formData
      })
      .then(function(response) { return response.json(); })
      .then(function(data) {
        if (data.result === 1 && data.RowID) {
          launch_toast(i18n[currentLang].toast_success, 1);
          setTimeout(function() {
            window.location.href = '/approvals-detalle?RowID=' + data.RowID;
          }, 1500);
        } else {
          launch_toast(data.error || i18n[currentLang].toast_error, 2);
          if (_btn) _btn.reset(i18n[currentLang].btn_submit);
        }
      })
      .catch(function(err) {
        launch_toast(i18n[currentLang].toast_error, 2);
        if (_btn) _btn.reset(i18n[currentLang].btn_submit);
      });
    }
