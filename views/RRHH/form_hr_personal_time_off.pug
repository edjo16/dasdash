extends ../layout
include ../mixins/floating-input
include ../mixins/floating-textarea
include ../mixins/floating-file
include ../mixins/floating-select
include ../mixins/floating-date
include ../ui/button-submit
include ../mixins/breadcrumb

block layout-content
  link(rel="stylesheet" href="/css/personal-time-off.css")
  div#layoutSidenav_content
    main
      div.container-fluid.px-4
        +app-breadcrumb({
          homeHref: '/',
          items: [{ label: title, active: true }]
        })

        //- Language Toggle
        div.pto-lang-toggle
          span(style="font-size:0.85rem;color:#666;" data-i18n="lang_hint") You may change the language of the questionnaire
          button#btn-lang-en.pto-lang-btn.active(type="button" onclick="switchLang('en')") EN
          button#btn-lang-es.pto-lang-btn(type="button" onclick="switchLang('es')") ES

        //- Stepper
        div.pto-stepper
          div.pto-step-indicator.active(data-step="1")
            div.pto-step-circle 1
            span.pto-step-label(data-i18n="step_info") Information
          div.pto-step-indicator(data-step="2")
            div.pto-step-circle 2
            span.pto-step-label(data-i18n="step_type") Request Type
          div.pto-step-indicator(data-step="3")
            div.pto-step-circle 3
            span.pto-step-label(data-i18n="step_details") Details
          div.pto-step-indicator(data-step="4")
            div.pto-step-circle 4
            span.pto-step-label(data-i18n="step_review") Review

        //- ============================
        //- STEP 1: Introduction
        //- ============================
        div.pto-step-content.active(data-step="1")
          div.pto-intro-card
            h3(data-i18n="intro_title") Absence approval process flow
            p(data-i18n="intro_p1") Fill this form from your "personal user" to request personal time / vacation or to record absences.
            p(data-i18n="intro_p2") Ordinarily personal time/vacation periods are requested well in advance and previously agreed with your supervisor in weekly or bi-weekly periods. In addition to the approval of your direct supervisor you must have a vacation accrual that will be validated by Human Resources.
            p(data-i18n="intro_p3") All employees must ensure that they have a backup colleague and leave their responsibilities organized and delegated during planned periods of absence, and schedule an out-of-office message in their email account, in order to ensure business continuity.
            p(data-i18n="intro_p4") Use the annotation space to provide relevant information to give context to the situation. For example, if dates were changed from what was previously agreed upon for any reason, etc.
            p(data-i18n="intro_p5") Medical absences or other justifiable causes must be evidenced by attaching a PDF document with the medical certificate or other evidence of the calamity indicated.
            p(data-i18n="intro_p6") If you receive a rejection to your application, take into account the annotations that accompany the rejection and apply again making the suggested corrections.
          div.pto-nav-buttons
            div
            button.pto-btn.pto-btn-next(type="button" onclick="ptoNext()")
              span(data-i18n="btn_next") Next
              i.fas.fa-arrow-right

        //- ============================
        //- STEP 2: Request Type
        //- ============================
        div.pto-step-content(data-step="2")
          div.pto-form-section
            h4(data-i18n="select_type_title") Select Request Type
            div.pto-info-alert
              i.fas.fa-info-circle
              span(data-i18n="select_type_hint") Select just one. Full day absences, only the "Partial permit" option allows to record absence hours.
            div.pto-type-grid
              div.pto-type-card(data-type="vacation" onclick="selectType(this)")
                span.pto-type-icon 🏖️
                div.pto-type-title(data-i18n="type_vacation") Request Vacation / Out of office period
                div.pto-type-desc(data-i18n="type_vacation_desc") Request planned vacation or time off periods.
              div.pto-type-card(data-type="medical_cert" onclick="selectType(this)")
                span.pto-type-icon 🏥
                div.pto-type-title(data-i18n="type_medical_cert") Register absence with medical certificate
                div.pto-type-desc(data-i18n="type_medical_cert_desc") Register absence supported by a medical certificate.
              div.pto-type-card(data-type="no_medical_cert" onclick="selectType(this)")
                span.pto-type-icon 📋
                div.pto-type-title(data-i18n="type_no_medical_cert") Register absence without medical certificate
                div.pto-type-desc(data-i18n="type_no_medical_cert_desc") Register absence without medical evidence.
              div.pto-type-card(data-type="partial_permit" onclick="selectType(this)")
                span.pto-type-icon ⏰
                div.pto-type-title(data-i18n="type_partial_permit") Partial permit
                div.pto-type-desc(data-i18n="type_partial_permit_desc") Record partial day absence with specific hours.
              div.pto-type-card(data-type="non_remunerated" onclick="selectType(this)")
                span.pto-type-icon 📅
                div.pto-type-title(data-i18n="type_non_remunerated") Non-remunerated time
                div.pto-type-desc(data-i18n="type_non_remunerated_desc") Request unpaid time off period.
              div.pto-type-card(data-type="license" onclick="selectType(this)")
                span.pto-type-icon 📄
                div.pto-type-title(data-i18n="type_license") License
                div.pto-type-desc(data-i18n="type_license_desc") Request a licensed leave period.
            input#request_type(type="hidden" name="request_type" data-required="true")
          div.pto-nav-buttons
            button.pto-btn.pto-btn-prev(type="button" onclick="ptoPrev()")
              i.fas.fa-arrow-left
              span(data-i18n="btn_prev") Previous
            button.pto-btn.pto-btn-next(type="button" onclick="ptoNext()" disabled)
              span(data-i18n="btn_next") Next
              i.fas.fa-arrow-right

        //- ============================
        //- STEP 3: Form Details
        //- ============================
        div.pto-step-content(data-step="3")
          form#form_hr_personal_time_off(method="post" enctype="multipart/form-data" autocomplete="off")
            div.pto-form-section
              h4(data-i18n="details_title") Request Details

              //- Partial Permit - Time fields (hidden by default)
              div#partial-permit-fields(style="display:none;")
                div.pto-info-alert
                  i.fas.fa-clock
                  span(data-i18n="partial_permit_hint") Select the start and end hours for your partial absence (8:00 AM - 5:00 PM, 30 min intervals).
                div.pto-time-row
                  div
                    - var hourOptions = [{value:'08:00 AM',label:'08:00 AM'},{value:'08:30 AM',label:'08:30 AM'},{value:'09:00 AM',label:'09:00 AM'},{value:'09:30 AM',label:'09:30 AM'},{value:'10:00 AM',label:'10:00 AM'},{value:'10:30 AM',label:'10:30 AM'},{value:'11:00 AM',label:'11:00 AM'},{value:'11:30 AM',label:'11:30 AM'},{value:'12:00 PM',label:'12:00 PM'},{value:'12:30 PM',label:'12:30 PM'},{value:'01:00 PM',label:'01:00 PM'},{value:'01:30 PM',label:'01:30 PM'},{value:'02:00 PM',label:'02:00 PM'},{value:'02:30 PM',label:'02:30 PM'},{value:'03:00 PM',label:'03:00 PM'},{value:'03:30 PM',label:'03:30 PM'},{value:'04:00 PM',label:'04:00 PM'},{value:'04:30 PM',label:'04:30 PM'},{value:'05:00 PM',label:'05:00 PM'}]
                    +floating-select("Start Hour", "start_permit_hour", hourOptions, false, "Select start hour")
                  div
                    +floating-select("End Hour", "end_permit_hour", hourOptions, false, "Select end hour")

              //- Date fields
              div.row
                div.col-md-6
                  +floating-date("Start Date", "start_date", true, "DD/MM/YYYY")
                div.col-md-6
                  +floating-date("End Date", "end_date", true, "DD/MM/YYYY")

              //- Notes
              div.row
                div.col-md-12
                  +floating-textarea("Notes / Annotations", "notes", false, "Provide relevant information for the context of the situation... (MAX 500 characters)", "", "", {maxlength: "500"}, 4)

              //- Support Document
              div.row
                div.col-md-12
                  +floating-file("PDF Support Document", "Supportfiles", false, false, false, "application/pdf,image/*")
              div.pto-file-note
                span(data-i18n="file_note") Mandatory for certified medical absences and optional for all other options.  Name the file with your own name and situation, for example: "Illness - Juan Perez" / "Disability Certificate - Ana Gonzalez". Allowed: PDF, Image

          div.pto-nav-buttons
            button.pto-btn.pto-btn-prev(type="button" onclick="ptoPrev()")
              i.fas.fa-arrow-left
              span(data-i18n="btn_prev") Previous
            button.pto-btn.pto-btn-next(type="button" onclick="ptoNext()")
              span(data-i18n="btn_next") Next
              i.fas.fa-arrow-right

        //- ============================
        //- STEP 4: Review & Submit
        //- ============================
        div.pto-step-content(data-step="4")
          div.pto-form-section
            h4(data-i18n="review_title") Review your request
            table.pto-review-table
              tr
                th(data-i18n="review_requestor") Requestor
                td#review-requestor #{userProfile.UserName}
              tr
                th(data-i18n="review_type") Request Type
                td#review-type -
              tr#review-hours-row(style="display:none")
                th(data-i18n="review_hours") Hours
                td#review-hours -
              tr
                th(data-i18n="review_start") Start Date
                td#review-start -
              tr
                th(data-i18n="review_end") End Date
                td#review-end -
              tr
                th(data-i18n="review_notes") Notes
                td#review-notes -
              tr
                th(data-i18n="review_files") Support Document
                td#review-files -

          //- Actors Panel
          div.pto-form-section(style="margin-top:16px;")
            h4
              span(data-i18n="review_actors") Approval Flow
            div#pto-actors-panel(style="display:none;")

          div.pto-confirm-row
            input#confirmSubmit(type="checkbox")
            label(for="confirmSubmit" data-i18n="confirm_label") Are you sure you want to submit this request?

          div.pto-nav-buttons
            button.pto-btn.pto-btn-prev(type="button" onclick="ptoPrev()")
              i.fas.fa-arrow-left
              span(data-i18n="btn_prev") Previous
            div.pto-btn-container  
              +submit-button('btnSubmitPto', 'Submit', '', 'fas fa-paper-plane')

