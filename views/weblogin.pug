
doctype html
html
    head
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet" href="/login-v2.css")
        script(src='/js/FontAwesomeFree5.15.4.js')
        title #{title} | Active Re
    body
        div.login-wrapper
            //- Left panel - Form
            div.login-panel-left
                div.login-form-container
                    //- Logo
                    div.login-form-logo
                        img(src="/ACRE_LOGO-02.svg" alt="Active Re")

                    //- Avatar section (shown if user is remembered)
                    div#avatarSection.login-avatar-section(style="display:none;")
                        img#userAvatar.login-avatar(src="/pic/default.png" alt="User" onerror="this.src='/pic/default.png';")
                        div#avatarName.login-avatar-name
                        div.login-avatar-hint Not you?
                            a(href="#" onclick="clearSavedUser(); return false;" style="margin-left:4px;color:var(--login-primary);text-decoration:none;font-weight:600;") Switch account

                    //- Title
                    h1.login-title Sign in
                    p.login-subtitle Enter your credentials to access your account

                    //- Error
                    if(okForm==0)
                        div.login-error
                            i.fas.fa-exclamation-circle
                            span Invalid email or password

                    //- Form
                    form.login-form(method="POST" action="/weblogin" enctype="multipart/form-data")
                        div.login-field
                            label.login-field-label Email
                            i.login-field-icon.fas.fa-envelope
                            input#name.login-field-input(name="name" type="text" placeholder="name@company.com" required value=UserEmail1 autocomplete="username")

                        div.login-field
                            label.login-field-label Password
                            i.login-field-icon.fas.fa-lock
                            input#code.login-field-input(name="code" type="password" placeholder="Enter your password" required autocomplete="current-password")
                            button.login-password-toggle(type="button" onclick="togglePassword('code', this)" tabindex="-1")
                                i.fas.fa-eye

                        button.login-btn.login-btn-primary(type="submit")
                            span Sign In
                            i.fas.fa-arrow-right

                        button.login-btn.login-btn-secondary(type="button" id="forgot_password")
                            i.fas.fa-key
                            span Forgot Password?

                    div.login-footer
                        | &copy; #{new Date().getFullYear()} Active Re. All rights reserved.

            //- Right panel - Branding
            div.login-panel-right
                div.login-waves
                    div.login-wave.login-wave-1
                    div.login-wave.login-wave-2
                    div.login-wave.login-wave-3
                    div.login-wave.login-wave-4
                //- SVG animated waves at bottom
                div.login-svg-waves
                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none" style="width:100%;height:120px;")
                        path(fill="rgba(255,255,255,0.06)" d="M0,224L48,213.3C96,203,192,181,288,186.7C384,192,480,224,576,218.7C672,213,768,171,864,165.3C960,160,1056,192,1152,197.3C1248,203,1344,181,1392,170.7L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z")
                        path(fill="rgba(255,255,255,0.04)" d="M0,288L48,272C96,256,192,224,288,218.7C384,213,480,235,576,245.3C672,256,768,256,864,234.7C960,213,1056,171,1152,165.3C1248,160,1344,192,1392,208L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z")
                div.login-brand
                    img(src="/ACRE_LOGO-02.svg" alt="Active Re")
                    div.login-brand-tagline Dashboard Management System

    script.
        // Toggle password visibility
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Remembered user with avatar
        (function() {
            var input = document.getElementById('name');
            var saved = localStorage.getItem('session_last_user');
            if (input && saved && !input.value) {
                input.value = saved;
            }
            var username = input ? input.value.trim() : '';
            if (username) {
                showAvatar(username);
            }

            // Save on submit
            var form = document.querySelector('form.login-form');
            if (form) {
                form.addEventListener('submit', function() {
                    var val = input ? input.value.trim() : '';
                    if (val) localStorage.setItem('session_last_user', val);
                });
            }

            // Update avatar on email change
            if (input) {
                input.addEventListener('blur', function() {
                    var val = input.value.trim();
                    if (val) showAvatar(val);
                    else hideAvatar();
                });
            }
        })();

        function showAvatar(email) {
            // Extract username before @ for pic lookup
            var username = email.indexOf('@') !== -1 ? email.split('@')[0] : email;
            var section = document.getElementById('avatarSection');
            var avatar = document.getElementById('userAvatar');
            var nameEl = document.getElementById('avatarName');
            avatar.src = '/pic/' + username + '.png';
            nameEl.textContent = email;
            section.style.display = 'flex';
        }

        function hideAvatar() {
            document.getElementById('avatarSection').style.display = 'none';
        }

        function clearSavedUser() {
            localStorage.removeItem('session_last_user');
            document.getElementById('name').value = '';
            hideAvatar();
            document.getElementById('name').focus();
        }

        // Forgot password redirect
        try {
            document.getElementById('forgot_password').addEventListener('click', function(e) {
                e.preventDefault();
                window.location.href = '/webloginforgot';
            });
        } catch(e) {}

        // Focus password if email is pre-filled
        window.addEventListener('DOMContentLoaded', function() {
            var emailInput = document.getElementById('name');
            if (emailInput && emailInput.value.trim()) {
                document.getElementById('code').focus();
            } else if (emailInput) {
                emailInput.focus();
            }
        });

        // Auto-dismiss error
        if(document.querySelector('.login-error')) {
            setTimeout(function() {
                var err = document.querySelector('.login-error');
                if (err) {
                    err.style.transition = 'opacity 0.4s';
                    err.style.opacity = '0';
                    setTimeout(function() { err.remove(); }, 400);
                }
            }, 8000);
        }
