include ../../mixins/modal-container
include ../../mixins/floating-input
include ../../mixins/floating-select
include ../../mixins/floating-textarea

+modal-container('tclModal', 'tclModalTitle', 'tclModalClose', 'tclModalCancel', 'tclModalSave', 'Temporary Change Location')
  input#tcl_id(type='hidden')
  input#tcl_hidden_collaborator_name(type='hidden' value=(userMenu && userMenu.Name) ? userMenu.Name : '')
  input#tcl_hidden_collaborator_title(type='hidden' value=(userMenu && userMenu.xcargo) ? userMenu.xcargo : '')
  input#tcl_hidden_department(type='hidden' value=(userProfile && userProfile.cdepartamento) ? userProfile.cdepartamento : '')
  input#tcl_hidden_manager(type='hidden' value=(userProfile && userProfile.manager && userProfile.manager.UserID) ? userProfile.manager.UserID : '')
  input#tcl_hidden_manager_name(type='hidden' value=(userProfile && userProfile.manager && userProfile.manager.Name) ? userProfile.manager.Name : '')
  input#tcl_hidden_manager_title(type='hidden' value=(userProfile && userProfile.manager && userProfile.manager.xcargo) ? userProfile.manager.xcargo : '')
  input#tcl_hidden_area_supervisor(type='hidden' value=(userProfile && userProfile.area_supervisor) ? userProfile.area_supervisor : '')
  input#tcl_hidden_suplente(type='hidden' value=(userProfile && userProfile.suplente) ? userProfile.suplente : '')

  div#tclViewInfo(style='display:none;')
