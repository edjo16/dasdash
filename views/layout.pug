      script.
        function clearUserLocalStorage() {
          ['approvalFilters', 'crm_main_filters', 'backpage', 'new_item', 'error'].forEach(function(k) {
            localStorage.removeItem(k);
          });
        }
        async function devteamuser(object) {
          try {
            clearUserLocalStorage();
            const response = await fetch('/devteam/switch-user', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                targetUserID: object.value
              })
            });

            const data = await response.json();

            if (!data.ok) {
              alert(data.message || 'Is not possible to change of user');
              return;
            }
            window.location.href = '/';
          } catch (error) {
            console.error(error);
            alert('Error changing user');
          }
        }
        async function restoreDevUser() {
          try {
            clearUserLocalStorage();
            const response = await fetch('/devteam/restore-user', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              }
            });

            const data = await response.json();

            if (!data.ok) {
              alert(data.message || 'No fue posible restaurar el usuario');
              return;
            }

            window.location.href = '/';
          } catch (error) {
            console.error(error);
            alert('Error al restaurar el usuario');
          }
        }
        function devteamdb(object) {
          var url_string = window.location.href;
          var url = new URL(url_string);

          if (url.searchParams.has('dbdevteam')) {
            url.searchParams.delete('dbdevteam');
          }

          if (object.value == 'live') {
            url.host = "vps-file01";
          } else if (object.value == 'dv') {
            url.host = "vps-desa01";
          }

          url.searchParams.set('dbdevteam', object.value);

          window.location.href = url.toString();
        }

        var url_string = window.location.href;
        var url = new URL(url_string);
        var db = url.searchParams.get("dbdevteam");
        var s = document.getElementById("dev-data");
        var OPT1 = document.createElement('OPTION');
        OPT1.setAttribute('value', "live");
        var OPT2 = document.createElement('OPTION');
        OPT2.setAttribute('value', "dv");

        var hostname = window.location.hostname;
        var environment = (hostname === 'localhost' || hostname === 'vps-desa01') ? 'dv' : 'live';

        var currentEnv = db || environment;

        if (db) {
            if (db === "live") {
                OPT1.setAttribute('selected', 'selected');
            } else {
                OPT2.setAttribute('selected', 'selected');
            }
        } else {
            if (environment === 'live') {
                OPT1.setAttribute('selected', 'selected');
            } else {
                OPT2.setAttribute('selected', 'selected');
            }
        }

        OPT1.appendChild(document.createTextNode('Live'));
        OPT2.appendChild(document.createTextNode('Development'));
        s.appendChild(OPT1);
        s.appendChild(OPT2);

        s.classList.remove('env-select-live', 'env-select-dev');
        if (currentEnv === 'live') {
          s.classList.add('env-select-live');
        } else {
          s.classList.add('env-select-dev');
        }

      script.
        function toggleDarkMode() {
          var html = document.documentElement;
          var current = html.getAttribute('data-theme');
          var next = current === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          var darkVal = next === 'dark' ? 1 : 0;
          fetch('/api/users/darkmode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ DarkMode: darkVal })
          }).catch(function(err) { console.error('Error saving dark mode:', err); });
        }
        window.addEventListener('storage', function(e) {
          if (e.key === 'theme' && e.newValue) {
            document.documentElement.setAttribute('data-theme', e.newValue);
          }
        });
        function uploadUserPhoto(input) {
          if (!input.files || !input.files[0]) return;
          var file = input.files[0];
          if (file.type !== 'image/png') {
            launch_toast('Only PNG images are allowed', 2);
            return;
          }
          var formData = new FormData();
          formData.append('userImage', file);
          formData.append('userID', document.getElementById('UsuarioID').value);
          var userId = document.getElementById('UsuarioID').value;
          fetch('/api/users/' + userId + '/image', {
            method: 'POST',
            body: formData
          }).then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.result === 1) {
                launch_toast('Photo updated', 1);
                setTimeout(function() { window.location.reload(); }, 1000);
              } else {
                launch_toast(data.message || 'Error uploading', 2);
              }
            }).catch(function(err) {
              console.error(err);
              launch_toast('Error uploading photo', 2);
            });
        }

