                img.user-chip-avatar(src="/pic/"+userProfile.UsuarioID+".png" onerror="this.onerror=null;this.src='/pic/default.png';")
                i.fas.fa-chevron-down.user-chip-caret
            ul(class="dropdown-menu dropdown-menu-end user-dropdown" aria-labelledby="navbarDropdown")
                li.user-dropdown-header
                  img.user-dropdown-avatar(src="/pic/"+userProfile.UsuarioID+".png" onerror="this.onerror=null;this.src='/pic/default.png';")
                  div.user-dropdown-info
                    span.user-dropdown-name= userProfile.UserName
                    span.user-dropdown-email= userProfile.UserEmail || ''
                li
                  hr.dropdown-divider
                li
                  label.dropdown-item(for="userImageUpload")
                    i.fas.fa-camera.me-2
                    | Change Photo
                    input#userImageUpload(type="file" accept="image/png" style="display:none;" onchange="uploadUserPhoto(this)")
                li
